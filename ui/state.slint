// Estado compartilhado entre a interface e o Rust (src/ui.rs).
// O Rust escreve as propriedades e implementa os callbacks.

export struct Stream {
    name: string,
    title: string,
    code: string,
    viewers: int,
    quality: string,
    since: string,
    initials: string,
    cover: int,
    watching: bool,
    // Vaga vazia para completar a linha da grade.
    blank: bool,
    // Pede senha.
    locked: bool,
    // Transmissão de um amigo (e só para amigos: fora do mural público).
    friend: bool,
    friends-only: bool,
}

// Figura da impressão da chave (docs/amizades.md): forma 0–3, cor 0–5.
export struct Glyph {
    shape: int,
    color: int,
}

// Um amigo no bloco "Amigos" do Início. `action`: texto do botão ("Assistir",
// "Ir junto", "Convidar" ou vazio); `code`: o código que o botão abre.
export struct FriendItem {
    key: string,
    name: string,
    initials: string,
    cover: int,
    detail: string,
    online: bool,
    live: bool,
    action: string,
    code: string,
}

// Um aparelho da conta.
export struct DeviceItem {
    dev: string,
    name: string,
    current: bool,
}

// Pedido de amizade recebido ou enviado.
export struct RequestItem {
    key: string,
    name: string,
    initials: string,
    cover: int,
    detail: string,
}

export struct StreamRow {
    items: [Stream],
}

export struct WatchingItem {
    id: string,
    name: string,
    initials: string,
    cover: int,
    detail: string,
    // Código de amigo do host e o botão ("Adicionar", ou vazio).
    friend: string,
    friend-action: string,
}

export struct Source {
    id: string,
    name: string,
    detail: string,
    thumb: image,
    has-thumb: bool,
    is-window: bool,
    primary: bool,
    current: bool,
    blank: bool,
}

export struct SourceRow {
    items: [Source],
}

export struct Peer {
    id: int,
    name: string,
    initials: string,
    state-text: string,
    connected: bool,
    // Código de amigo de quem assiste e o botão ("Adicionar", ou vazio).
    friend: string,
    friend-action: string,
}

export struct AudioApp {
    exe: string,
    name: string,
    active: bool,
}

export struct SelectOption {
    value: string,
    label: string,
}

// Uma transmissão que estou assistindo. x/y/w/h: posição na área dos tiles,
// calculada no Rust (o player nativo fica exatamente sobre a área de vídeo).
// Opção de um menu de escolha (fps, qualidade). `tag` = selo (ex.: "FG 2x").
export struct MenuOption {
    value: string,
    label: string,
    tag: string,
    note: string,
    selected: bool,
}

export struct Tile {
    id: string,
    // Multiplicador da geração de quadros ativa ("2x"), vazio se desligada.
    gen-tag: string,
    name: string,
    initials: string,
    watching: bool,
    step: int,
    // O host está ocupado com outras entradas (o pedido é repetido sozinho).
    busy: bool,
    res: string,
    rate: string,
    ping: string,
    ping-warn: bool,
    volume: int,
    muted: bool,
    // Controles por cima do vídeo à mostra (somem com o mouse parado).
    chrome: bool,
    focused: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

export struct Toast {
    id: int,
    text: string,
    kind: string,
}

export global App {
    // ----------------------------------------------------------------- geral
    in property <string> title: "AntiJanja";
    in property <string> view: "home";
    in property <string> net: "pending";
    in property <bool> fullscreen;
    // Janela com menos de 1100 px de largura (calculado no Rust: na interface viraria um
    // laço, a largura mínima da janela depende da barra do topo).
    in property <bool> narrow;
    in property <bool> live;
    in property <int> host-viewers;
    in property <int> watch-count;
    in-out property <string> my-name;
    callback navigate(string);
    callback toggle-theme();
    callback name-edited(string);
    callback layout-changed();
    callback key-f11();
    callback key-escape();

    // ---------------------------------------------------------------- Início
    in property <bool> public-loading: true;
    in property <bool> public-busy;
    in property <int> public-count;
    in property <int> public-watching;
    in property <bool> public-mine;
    in property <bool> has-featured;
    in property <Stream> featured;
    in property <[StreamRow]> rows;
    in property <[WatchingItem]> watching-list;
    callback refresh-public();
    callback watch(string);
    callback copy-code(string);
    callback join(string);
    callback paste-join();
    // Ctrl+V fora de um campo de texto: entra com o código copiado (só no Início).
    callback key-paste();
    // Código de live ou de amigo que apareceu na área de transferência (vazio = nenhum).
    in property <string> clip-code;
    in property <bool> clip-friend;
    callback clip-use();
    callback clip-dismiss();

    // ------------------------------------------------- Configurações da transmissão
    in property <string> s-res: "1080";
    in property <string> s-fps: "60";
    in property <string> s-bitrate: "0";
    in property <bool> s-cursor: true;
    in property <bool> s-mesh;
    in property <bool> s-relay;
    in property <string> s-audio-mode: "system";
    in property <string> s-audio-app;
    in property <string> s-abitrate: "192";
    in property <int> s-volume: 100;
    in property <bool> s-public: true;
    in property <[AudioApp]> apps;
    // Mesma lista, pronta para o seletor ("Discord · tocando agora").
    in property <[SelectOption]> app-options;
    callback set-setting(string, string);
    in property <bool> s-password-set;
    // Senha escolhida na tela "O que você quer transmitir?" (vale ao começar).
    in property <bool> picker-pw-on;
    in property <string> picker-pw;
    callback picker-pw-toggled(bool);
    callback picker-pw-edited(string);
    // Janela de senha para assistir uma transmissão com senha.
    in property <bool> password-prompt;
    in property <string> password-error;
    callback submit-password(string);
    callback cancel-password();
    callback refresh-apps();

    // --------------------------------------------------------------- Seletor
    in property <string> picker;
    in property <string> picker-tab: "monitor";
    in property <bool> sources-loading;
    in property <[SourceRow]> source-rows;
    in property <int> count-monitors;
    in property <int> count-windows;
    in property <string> picker-selected;
    callback open-picker(string);
    callback close-picker();
    callback picker-refresh();
    callback picker-tab-changed(string);
    callback picker-select(string);
    callback picker-confirm(string);

    // ----------------------------------------------------------- Transmitindo
    in property <string> source-name;
    in property <image> preview;
    in property <bool> has-preview;
    in property <bool> has-info;
    in property <string> stat-res;
    in property <string> stat-fps;
    in property <string> stat-rate;
    // Limite imposto pela rede de quem assiste (vazio = sem limite).
    in property <string> stat-net;
    /// Malha P2P ligada: quantos estão nela e quanto do envio normal o host manda.
    in property <string> stat-mesh;
    in property <bool> hardware;
    in property <string> encoder-line;
    in property <string> encoder-detail;
    in property <string> code;
    in property <string> code-prefix;
    in property <string> code-body;
    in property <[Peer]> peers;
    in property <string> audio-status: "Sem áudio";
    in property <string> audio-status-kind;
    in property <float> audio-level;
    callback stop-sharing();
    callback new-code();
    callback copy-my-code();
    // Copia o link de convite (antijanja://entrar/<código>).
    callback copy-my-link();
    callback kick(int);

    // -------------------------------------------------------------- Assistindo
    in property <[Tile]> tiles;
    in property <bool> has-focus;
    callback leave(string);
    callback unfocus();
    // fps para assistir ("0" = o da stream), vale para todas as streams. Acima do da
    // stream precisa de placa NVIDIA (geração de quadros).
    in property <bool> framegen-available;
    in property <string> view-fps: "0";
    // Stream com o menu de engrenagem aberto. Os controles por cima do vídeo e o menu
    // ficam em outra janela (ui/overlay.slint, global Ov); aqui só o clique fora fecha.
    in property <string> menu-tile;
    callback close-menu();

    // ---------------------------------------------------------------- Amigos
    in property <[RequestItem]> friend-requests;
    in property <[RequestItem]> friend-sent;
    in property <[FriendItem]> friends-online;
    in property <[FriendItem]> friends-offline;
    in property <int> friends-count;
    in property <bool> friends-show-offline;
    in property <int> friends-offline-count;
    callback toggle-offline();
    callback friend-accept(string);
    callback friend-decline(string);
    callback friend-action(string, string);
    callback friend-remove(string);
    // Adicionar quem está na mesma live (pelo código de amigo que veio na conexão).
    callback add-friend-code(string);
    // Convite recebido para assistir (vazio = nenhum).
    in property <string> invite-name;
    in property <string> invite-title;
    in property <string> invite-code;
    callback invite-accept();
    callback invite-dismiss();

    // ----------------------------------------------------------------- Conta
    in property <string> my-fingerprint;
    in property <string> my-initials;
    in property <[Glyph]> my-glyphs;
    in property <string> my-friend-code;
    in property <bool> account-open;
    in property <bool> account-primary;
    in property <string> account-device;
    // As 24 palavras, só enquanto estão à mostra.
    in property <[string]> account-phrase;
    in property <bool> account-restore;
    in property <string> account-error;
    callback open-account();
    callback close-account();
    callback copy-friend-code();
    callback show-phrase(bool);
    callback restore-mode(bool);
    callback restore-account(string);
    in property <[DeviceItem]> account-devices;
    // Vincular aparelhos: "" (nada), "join" (este PC esperando ser vinculado) ou
    // "add" (o principal digitando o código do aparelho novo).
    in property <string> link-mode;
    in property <string> link-code;
    in property <[Glyph]> link-glyphs;
    in property <string> link-error;
    in property <bool> link-busy;
    in property <string> link-offer-name;
    in property <[Glyph]> link-offer-glyphs;
    callback link-start();
    callback link-add();
    callback link-cancel();
    callback link-lookup(string);
    callback link-confirm();
    callback link-revoke(string);

    // ------------------------------------------------- Avisos e atualização
    in property <[Toast]> toasts;
    in property <string> update-version;
    in property <float> update-progress: -1;
}
