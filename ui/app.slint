// Janela principal do AntiJanja.
import { Theme } from "theme.slint";
import { App, Stream, StreamRow, WatchingItem, Source, SourceRow, Peer, AudioApp, SelectOption, MenuOption, Tile, Toast, Glyph, FriendItem, RequestItem, DeviceItem } from "state.slint";
import { Btn, Cover, Eyebrow, Icon, KeyGlyphs, TextField } from "widgets.slint";
import { HomeView } from "home.slint";
import { HostView } from "host.slint";
import { WatchView } from "watch.slint";
import { SourcePicker } from "picker.slint";
import { VideoOverlay, Ov } from "overlay.slint";

export { Theme, App, Ov, VideoOverlay, Stream, StreamRow, WatchingItem, Source, SourceRow, Peer, AudioApp, SelectOption, MenuOption, Tile, Toast, Glyph, FriendItem, RequestItem, DeviceItem }

component Logo inherits Rectangle {
    width: 22px;
    height: 22px;
    // Duas janelas sobrepostas + o ponto "ao vivo".
    Rectangle {
        x: parent.width * 4 / 32;
        y: parent.height * 7 / 32;
        width: parent.width * 17 / 32;
        height: parent.height * 12 / 32;
        border-radius: 2px;
        border-width: 2px;
        border-color: Theme.fg;
    }
    Rectangle {
        x: parent.width * 11 / 32;
        y: parent.height * 13 / 32;
        width: parent.width * 17 / 32;
        height: parent.height * 12 / 32;
        border-radius: 2px;
        background: Theme.fg;
    }
    Rectangle {
        x: parent.width * 4.4 / 32;
        y: parent.height * 22.4 / 32;
        width: parent.width * 5.2 / 32;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.live;
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <int> count: 0;
    in property <bool> live-dot: false;
    property <bool> on: App.view == target;
    height: 30px;
    border-radius: 6px;
    background: on ? Theme.muted : ta.has-hover ? Theme.muted.with-alpha(0.6) : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        if root.live-dot : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.live;
            }
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.on ? 600 : 500;
            color: root.on || ta.has-hover ? Theme.fg : Theme.muted-fg;
            vertical-alignment: center;
        }
        if root.count > 0 : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 17px;
                width: n.preferred-width + 10px;
                border-radius: 4px;
                background: root.on ? Theme.card : Theme.muted;
                n := Text {
                    x: 5px;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.count;
                    font-family: Theme.mono;
                    font-size: 11px;
                    color: Theme.fg;
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.navigate(root.target); }
    }
}

// Campo de código no topo: live (AJ3.…) ou amigo (AJF.…). Enter entra; o botão cola e entra.
component CodeField inherits Rectangle {
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.primary : Theme.input;
    background: Theme.card;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { source: @image-url("icons/link.svg"); tint: Theme.muted-fg; width: 14px; height: 14px; }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                color: Theme.fg;
                font-size: 13px;
                selection-background-color: Theme.primary.with-alpha(0.35);
                accessible-label: "Código de uma live ou de um amigo";
                accepted => {
                    App.join(self.text);
                    self.text = "";
                }
            }
            Text {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                visible: input.text == "";
                text: "Cole o código de uma live ou de um amigo";
                color: Theme.muted-fg;
                font-size: 13px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: "ghost";
                height: 24px;
                pad: 6px;
                font-size: 11px;
                text: input.text == "" ? "Ctrl+V" : "Entrar";
                accessible-label: input.text == "" ? "Colar o código e entrar" : "Entrar com o código";
                clicked => {
                    if (input.text != "") {
                        App.join(input.text);
                        input.text = "";
                    } else {
                        App.paste-join();
                    }
                }
            }
        }
    }
}

component TopBar inherits Rectangle {
    // Janela estreita: o status da rede vira só a bolinha.
    in property <bool> compact;
    height: 44px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Logo { }
        }
        Text { text: "AntiJanja"; font-size: 15px; font-weight: 800; letter-spacing: -0.3px; color: Theme.fg; vertical-alignment: center; }
        HorizontalLayout {
            padding-left: 16px;
            spacing: 4px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Tab { label: "Início"; target: "home"; }
            }
            if App.live : VerticalLayout {
                alignment: center;
                Tab { label: "Transmitindo"; target: "host"; live-dot: true; count: App.host-viewers; }
            }
            VerticalLayout {
                alignment: center;
                Tab { label: "Assistindo"; target: "watch"; count: App.watch-count; }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-left: 8px;
            padding-right: 8px;
            VerticalLayout {
                alignment: center;
                CodeField {
                    min-width: 200px;
                    preferred-width: 400px;
                    max-width: 400px;
                    horizontal-stretch: 1;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    accessible-role: text;
                    accessible-label: App.net == "ok" ? "Rede P2P conectada" : App.net == "err" ? "Sem rede P2P" : "Entrando na rede P2P";
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: App.net == "ok" ? Theme.live : App.net == "err" ? Theme.destructive : Theme.warn;
                }
            }
            if !root.compact : Text {
                text: App.net == "ok" ? "Rede P2P conectada" : App.net == "err" ? "Sem rede P2P" : "Entrando na rede P2P";
                font-size: 12px;
                color: Theme.muted-fg;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    width: 32px;
                    height: 32px;
                    kind: "ghost";
                    icon-only: true;
                    icon: Theme.dark ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                    has-icon: true;
                    accessible-label: Theme.dark ? "Usar tema claro" : "Usar tema escuro";
                    clicked => { App.toggle-theme(); }
                }
            }
        }
    }
}

// Código de live ou de amigo que apareceu na área de transferência: "Entrar" ou dispensar.
component ClipCard inherits Rectangle {
    height: 48px;
    width: row.preferred-width;
    border-radius: 12px;
    border-width: 1px;
    border-color: App.clip-friend ? Theme.friend-solid : Theme.primary;
    background: Theme.card;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000059;
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { source: @image-url("icons/paste.svg"); tint: App.clip-friend ? Theme.friend-text : Theme.live-text; width: 16px; height: 16px; }
        }
        Text {
            text: App.clip-friend ? "Código de amigo copiado" : "Código copiado";
            font-size: 13px;
            font-weight: 600;
            color: Theme.fg;
            vertical-alignment: center;
        }
        Text {
            text: App.clip-code;
            font-size: 12px;
            color: Theme.muted-fg;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: "primary";
                height: 32px;
                font-size: 13px;
                bold: true;
                text: App.clip-friend ? "Adicionar" : "Entrar";
                clicked => { App.clip-use(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: "ghost";
                width: 32px;
                height: 32px;
                icon-only: true;
                icon: @image-url("icons/x.svg");
                has-icon: true;
                icon-size: 12px;
                accessible-label: "Dispensar";
                clicked => { App.clip-dismiss(); }
            }
        }
    }
}

component Toasts inherits VerticalLayout {
    spacing: 8px;
    alignment: start;
    if App.clip-code != "" && !App.fullscreen : HorizontalLayout {
        alignment: center;
        ClipCard { }
    }
    for t in App.toasts : HorizontalLayout {
        alignment: center;
        Rectangle {
            width: Math.min(row.preferred-width, 520px);
            height: 44px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.card;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 16px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: t.kind == "err" ? Theme.destructive : t.kind == "ok" ? Theme.live : Theme.muted-fg;
                    }
                }
                Text {
                    text: t.text;
                    font-size: 13px;
                    color: Theme.fg;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

component UpdateOverlay inherits Rectangle {
    background: Theme.bg.with-alpha(0.97);
    TouchArea { }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 320px;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("icons/download.svg");
                        tint: Theme.primary;
                        width: 32px;
                        height: 32px;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Atualizando para a versão " + App.update-version; font-size: 15px; font-weight: 600; color: Theme.fg; horizontal-alignment: center; }
                    Text { text: "O AntiJanja reinicia sozinho quando terminar."; font-size: 13px; color: Theme.muted-fg; horizontal-alignment: center; }
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.muted;
                    clip: true;
                    Rectangle {
                        x: App.update-progress < 0 ? (parent.width * 1.3) * Math.mod(animation-tick() / 1.4s, 1) - parent.width * 0.3 : 0;
                        width: App.update-progress < 0 ? parent.width * 0.3 : parent.width * App.update-progress;
                        height: 100%;
                        border-radius: 3px;
                        background: Theme.primary;
                    }
                }
                if App.update-progress >= 0 : Text {
                    text: Math.round(App.update-progress * 100) + "%";
                    font-size: 12px;
                    color: Theme.muted-fg;
                    font-family: Theme.mono;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// Senha para assistir uma transmissão com senha.
component PasswordDialog inherits Rectangle {
    background: Theme.overlay;
    TouchArea { clicked => { App.cancel-password(); } }
    Rectangle {
        width: 380px;
        height: box.preferred-height;
        background: Theme.card;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000066;
        TouchArea { }
        box := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Icon { source: @image-url("icons/lock.svg"); tint: Theme.primary; width: 18px; height: 18px; }
                }
                Text { text: "Essa transmissão tem senha"; font-size: 16px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
            }
            Text { text: "Peça a senha para quem está transmitindo."; font-size: 13px; color: Theme.muted-fg; wrap: word-wrap; }
            field := TextField {
                secret: true;
                placeholder: "Senha";
                accepted(t) => { App.submit-password(t); }
                init => { self.focus-input(); }
            }
            if App.password-error != "" : Text { text: App.password-error; font-size: 12px; color: Theme.destructive; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { kind: "ghost"; text: "Cancelar"; clicked => { App.cancel-password(); } }
                Btn { kind: "primary"; text: "Assistir"; clicked => { App.submit-password(field.text); } }
            }
        }
    }
}

// Conta: código de amigo, este aparelho, frase de recuperação e entrar com outra conta.
component AccountDialog inherits Rectangle {
    background: Theme.overlay;
    TouchArea { clicked => { App.close-account(); } }
    Rectangle {
        width: 500px;
        height: Math.min(box.preferred-height, root.height - 48px);
        background: Theme.card;
        border-radius: 16px;
        clip: true;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000066;
        TouchArea { }
        Flickable {
        viewport-height: box.preferred-height;
        box := VerticalLayout {
            width: parent.width;
            padding: 24px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 14px;
                Cover {
                    width: 48px;
                    height: 48px;
                    border-radius: 12px;
                    idx: 1;
                    initials: App.my-initials;
                    text-size: 17px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    horizontal-stretch: 1;
                    Text { text: App.my-name; font-size: 18px; font-weight: 700; color: Theme.fg; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        KeyGlyphs { glyphs: App.my-glyphs; size: 10px; }
                        Text { text: App.my-fingerprint; font-size: 12px; color: Theme.soft-fg; font-family: Theme.mono; vertical-alignment: center; }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    Btn {
                        width: 34px;
                        height: 34px;
                        kind: "ghost";
                        icon-only: true;
                        icon: @image-url("icons/x.svg");
                        has-icon: true;
                        icon-size: 13px;
                        accessible-label: "Fechar";
                        clicked => { App.close-account(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                Eyebrow { text: "MEU CÓDIGO DE AMIGO"; }
                Rectangle {
                    height: 40px;
                    border-radius: 9px;
                    background: Theme.muted;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 5px;
                        spacing: 8px;
                        Text {
                            text: App.my-friend-code;
                            font-size: 12px;
                            font-family: Theme.mono;
                            color: Theme.soft-fg;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                kind: "primary";
                                height: 30px;
                                font-size: 12px;
                                pad: 12px;
                                text: "Copiar";
                                clicked => { App.copy-friend-code(); }
                            }
                        }
                    }
                }
                Text {
                    text: "Mande para quem você quer adicionar. Quem colar em “Entrar com código” te manda um pedido de amizade.";
                    font-size: 12px;
                    color: Theme.muted-fg;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    Eyebrow { text: "MEUS APARELHOS"; vertical-alignment: center; horizontal-stretch: 1; }
                    if App.account-primary && App.link-mode == "" : Btn {
                        kind: "ghost";
                        height: 28px;
                        font-size: 12px;
                        pad: 6px;
                        text: "+ Vincular aparelho";
                        clicked => { App.link-add(); }
                    }
                }
                for d in App.account-devices : HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: d.current ? Theme.live : Theme.input; }
                    }
                    Text { text: d.name; font-size: 13px; font-weight: d.current ? 600 : 400; color: Theme.fg; vertical-alignment: center; overflow: elide; }
                    Text {
                        text: d.current ? (App.account-primary ? "· este, principal" : "· este") : "";
                        font-size: 13px;
                        color: Theme.muted-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if App.account-primary && !d.current : VerticalLayout {
                        alignment: center;
                        Btn {
                            kind: "ghost";
                            height: 28px;
                            font-size: 12px;
                            pad: 8px;
                            text: "Desvincular";
                            clicked => { App.link-revoke(d.dev); }
                        }
                    }
                }
                if !App.account-primary : Text {
                    text: "Para vincular ou desvincular aparelhos, use o aparelho principal.";
                    font-size: 12px;
                    color: Theme.muted-fg;
                    wrap: word-wrap;
                }
            }

            // Principal: digitar o código do aparelho novo e conferir a figura.
            if App.link-mode == "add" : Rectangle {
                height: add.preferred-height;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.bg;
                add := VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text { text: "Vincular aparelho"; font-size: 14px; font-weight: 600; color: Theme.fg; }
                    if App.link-offer-name == "" : Text {
                        text: "No aparelho novo, abra “Meu código” › “Entrar com outra conta” › “Vincular a um aparelho”, e digite aqui o código que aparecer lá.";
                        font-size: 12px;
                        color: Theme.soft-fg;
                        wrap: word-wrap;
                    }
                    if App.link-offer-name == "" : HorizontalLayout {
                        spacing: 8px;
                        code := TextField {
                            mono: true;
                            placeholder: "Código de 6 números";
                            accepted(t) => { App.link-lookup(t); }
                            init => { self.focus-input(); }
                        }
                        Btn {
                            kind: "primary";
                            text: App.link-busy ? "Procurando…" : "Procurar";
                            enabled: !App.link-busy;
                            clicked => { App.link-lookup(code.text); }
                        }
                    }
                    if App.link-offer-name != "" : VerticalLayout {
                        spacing: 10px;
                        Text { text: "Encontrado: “" + App.link-offer-name + "” pedindo para entrar."; font-size: 13px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            KeyGlyphs { glyphs: App.link-offer-glyphs; size: 18px; }
                            Text { text: "A figura é a mesma nos dois aparelhos?"; font-size: 13px; color: Theme.soft-fg; vertical-alignment: center; }
                        }
                    }
                    if App.link-error != "" : Text { text: App.link-error; font-size: 12px; color: Theme.destructive; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Btn { kind: "ghost"; text: App.link-offer-name == "" ? "Cancelar" : "Não é a mesma"; clicked => { App.link-cancel(); } }
                        if App.link-offer-name != "" : Btn {
                            kind: "primary";
                            text: App.link-busy ? "Vinculando…" : "É a mesma, vincular";
                            enabled: !App.link-busy;
                            clicked => { App.link-confirm(); }
                        }
                    }
                }
            }

            if App.account-primary : Rectangle {
                height: phrase.preferred-height;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.warn.with-alpha(0.35);
                background: Theme.warn.with-alpha(0.08);
                phrase := VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Icon { source: @image-url("icons/lock.svg"); tint: Theme.warn; width: 15px; height: 15px; }
                        }
                        Text { text: "Frase de recuperação"; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
                        Btn {
                            kind: "outline";
                            height: 30px;
                            font-size: 12px;
                            pad: 12px;
                            text: App.account-phrase.length > 0 ? "Esconder" : "Mostrar";
                            clicked => { App.show-phrase(App.account-phrase.length == 0); }
                        }
                    }
                    Text {
                        text: "24 palavras que recriam sua conta em outro PC. Anote em papel. Sem a frase e sem este PC, a conta não tem volta: não existe servidor para recuperar.";
                        font-size: 12px;
                        color: Theme.soft-fg;
                        wrap: word-wrap;
                    }
                    if App.account-phrase.length > 0 : Rectangle {
                        height: 6 * 24px;
                        for w[i] in App.account-phrase : Text {
                            x: Math.mod(i, 4) * (parent.width / 4);
                            y: Math.floor(i / 4) * 24px;
                            width: parent.width / 4;
                            height: 24px;
                            vertical-alignment: center;
                            text: (i + 1) + ". " + w;
                            font-size: 12px;
                            font-family: Theme.mono;
                            color: Theme.fg;
                        }
                    }
                }
            }
            if !App.account-primary : Text {
                text: "A frase de recuperação fica no aparelho onde a conta foi criada.";
                font-size: 12px;
                color: Theme.muted-fg;
                wrap: word-wrap;
            }

            if !App.account-restore && App.link-mode != "join" : VerticalLayout {
                spacing: 6px;
                Eyebrow { text: "ENTRAR COM OUTRA CONTA"; }
                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        kind: "outline";
                        horizontal-stretch: 1;
                        height: 36px;
                        font-size: 12px;
                        text: "Vincular a um aparelho";
                        clicked => { App.link-start(); }
                    }
                    Btn {
                        kind: "outline";
                        horizontal-stretch: 1;
                        height: 36px;
                        font-size: 12px;
                        text: "Usar a frase de recuperação";
                        clicked => { App.restore-mode(true); }
                    }
                }
            }

            // Este PC esperando o principal digitar o código.
            if App.link-mode == "join" : Rectangle {
                height: join.preferred-height;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.primary.with-alpha(0.4);
                background: Theme.bg;
                join := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "No aparelho que já tem a conta (o principal), abra “Meu código” › “Vincular aparelho” e digite:";
                        font-size: 13px;
                        color: Theme.soft-fg;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 60px;
                        border-radius: 10px;
                        background: Theme.card;
                        Text {
                            text: App.link-code;
                            font-size: 30px;
                            font-family: Theme.mono;
                            letter-spacing: 6px;
                            color: Theme.primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text { text: "Figura deste pedido:"; font-size: 12px; color: Theme.muted-fg; vertical-alignment: center; }
                        KeyGlyphs { glyphs: App.link-glyphs; size: 18px; }
                    }
                    if App.link-error == "" : Text {
                        text: "Esperando o outro aparelho… O código vale por 5 minutos. A conta atual deste PC sai daqui quando vincular.";
                        font-size: 12px;
                        color: Theme.muted-fg;
                        wrap: word-wrap;
                    }
                    if App.link-error != "" : Text { text: App.link-error; font-size: 12px; color: Theme.destructive; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Btn { kind: "ghost"; text: "Cancelar"; clicked => { App.link-cancel(); } }
                        if App.link-error != "" : Btn { kind: "primary"; text: "Gerar outro código"; clicked => { App.link-start(); } }
                    }
                }
            }

            if App.account-restore : VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Digite as 24 palavras da outra conta. A conta atual sai deste PC: se ela for sua, anote a frase dela antes.";
                    font-size: 12px;
                    color: Theme.warn;
                    wrap: word-wrap;
                }
                field := TextField {
                    placeholder: "24 palavras separadas por espaço";
                    accepted(t) => { App.restore-account(t); }
                    init => { self.focus-input(); }
                }
                if App.account-error != "" : Text { text: App.account-error; font-size: 12px; color: Theme.destructive; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Btn { kind: "ghost"; text: "Cancelar"; clicked => { App.restore-mode(false); } }
                    Btn { kind: "primary"; text: "Entrar"; clicked => { App.restore-account(field.text); } }
                }
            }
        }
        }
    }
}


// Convite de um amigo para assistir a live dele.
component InviteCard inherits Rectangle {
    width: 360px;
    height: box.preferred-height;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.primary.with-alpha(0.4);
    background: Theme.card;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000055;
    box := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Icon { source: @image-url("icons/radio.svg"); tint: Theme.primary; width: 20px; height: 20px; }
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: App.invite-name + " te convidou para assistir"; font-size: 14px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                if App.invite-title != "" : Text { text: App.invite-title; font-size: 12px; color: Theme.muted-fg; overflow: elide; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Btn { kind: "primary"; horizontal-stretch: 1; text: "Assistir"; clicked => { App.invite-accept(); } }
            Btn { kind: "outline"; horizontal-stretch: 1; text: "Agora não"; clicked => { App.invite-dismiss(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: App.title;
    icon: @image-url("../assets/icons/128x128.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 940px;
    min-height: 620px;
    background: Theme.bg;
    default-font-family: Theme.sans;

    changed width => { App.layout-changed(); }
    changed height => { App.layout-changed(); }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.F11) {
                App.key-f11();
                return accept;
            }
            if (e.text == Key.Escape) {
                App.key-escape();
                return accept;
            }
            // Ctrl+V fora de um campo de texto (os campos ficam com o colar deles).
            if (e.modifiers.control && (e.text == "v" || e.text == "V")) {
                App.key-paste();
                return accept;
            }
            reject
        }

        VerticalLayout {
            if !App.fullscreen : TopBar { compact: App.narrow; }
            Rectangle {
                vertical-stretch: 1;
                if App.view == "home" : HomeView { }
                if App.view == "host" : HostView { }
                if App.view == "watch" : WatchView { }
            }
        }
    }

    if App.picker != "" : SourcePicker {
        width: 100%;
        height: 100%;
    }

    Toasts {
        x: 0;
        y: 56px;
        width: root.width;
    }

    if App.invite-code != "" : InviteCard {
        x: root.width - self.width - 20px;
        y: 56px;
    }

    if App.account-open : AccountDialog {
        width: 100%;
        height: 100%;
    }

    if App.password-prompt : PasswordDialog {
        width: 100%;
        height: 100%;
    }

    if App.update-version != "" : UpdateOverlay {
        width: 100%;
        height: 100%;
    }
}
