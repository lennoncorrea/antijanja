// Janela principal do AntiJanja.
import { Theme } from "theme.slint";
import { App, Stream, StreamRow, WatchingItem, Source, SourceRow, Peer, AudioApp, SelectOption, MenuOption, Tile, Toast, Glyph, FriendItem, RequestItem, DeviceItem } from "state.slint";
import { Btn, Cover, Dialog, Divider, Eyebrow, FocusRing, Icon, KeyGlyphs, LiveDot, Segmented, TextField } from "widgets.slint";
import { HomeView } from "home.slint";
import { HostView } from "host.slint";
import { WatchView } from "watch.slint";
import { SourcePicker } from "picker.slint";
import { VideoOverlay, Ov } from "overlay.slint";

export { Theme, App, Ov, VideoOverlay, Stream, StreamRow, WatchingItem, Source, SourceRow, Peer, AudioApp, SelectOption, MenuOption, Tile, Toast, Glyph, FriendItem, RequestItem, DeviceItem }

component Logo inherits Rectangle {
    width: 22px;
    height: 22px;
    accessible-role: image;
    accessible-label: "AntiJanja";
    // Duas janelas sobrepostas + o ponto "ao vivo".
    Rectangle {
        x: parent.width * 4 / 32;
        y: parent.height * 7 / 32;
        width: parent.width * 17 / 32;
        height: parent.height * 12 / 32;
        border-radius: 2px;
        border-width: 2px;
        border-color: Theme.fg;
    }
    Rectangle {
        x: parent.width * 11 / 32;
        y: parent.height * 13 / 32;
        width: parent.width * 17 / 32;
        height: parent.height * 12 / 32;
        border-radius: 2px;
        background: Theme.fg;
    }
    Rectangle {
        x: parent.width * 4.4 / 32;
        y: parent.height * 22.4 / 32;
        width: parent.width * 5.2 / 32;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.live;
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <int> count: 0;
    in property <bool> live-dot: false;
    property <bool> on: App.view == target;
    height: 28px;
    border-radius: Theme.radius-sm;
    background: on ? Theme.muted : ta.has-hover ? Theme.muted.with-alpha(0.6) : transparent;
    animate background { duration: Theme.fast; }
    accessible-role: tab;
    accessible-label: root.count > 0 ? root.label + ", " + root.count : root.label;
    accessible-item-selected: root.on;
    accessible-action-default => { App.navigate(root.target); }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                App.navigate(root.target);
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        if root.live-dot : VerticalLayout {
            alignment: center;
            LiveDot { }
        }
        Text {
            text: root.label;
            font-size: Theme.text-base;
            font-weight: root.on ? 600 : 500;
            color: root.on || ta.has-hover ? Theme.fg : Theme.muted-fg;
            vertical-alignment: center;
        }
        if root.count > 0 : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: n.preferred-width + 12px;
                border-radius: Theme.radius-xs;
                background: root.on ? Theme.card : Theme.muted;
                n := Text {
                    x: 6px;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.count;
                    font-family: Theme.mono;
                    font-size: Theme.text-xs;
                    color: Theme.fg;
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.navigate(root.target); }
    }
    if fs.has-focus : FocusRing { radius: root.border-radius; }
}

// Campo de código no topo: live (AJ3.…) ou amigo (AJF.…). Enter entra; o botão cola e entra.
component CodeField inherits Rectangle {
    height: 32px;
    border-radius: Theme.radius-md;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.focus : Theme.field-border;
    background: Theme.card;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { source: @image-url("icons/link.svg"); tint: Theme.muted-fg; width: 14px; height: 14px; }
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                color: Theme.fg;
                font-size: Theme.text-base;
                selection-background-color: Theme.primary.with-alpha(0.35);
                accessible-label: "Código de uma live ou de um amigo";
                accepted => {
                    App.join(self.text);
                    self.text = "";
                }
            }
            Text {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                visible: input.text == "";
                text: "Cole o código de uma live ou de um amigo";
                color: Theme.muted-fg;
                font-size: Theme.text-base;
                overflow: elide;
                accessible-role: none;
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: "ghost";
                size: "sm";
                height: 24px;
                pad: 6px;
                font-size: Theme.text-xs;
                text: input.text == "" ? "Ctrl+V" : "Entrar";
                accessible-label: input.text == "" ? "Colar o código e entrar" : "Entrar com o código";
                clicked => {
                    if (input.text != "") {
                        App.join(input.text);
                        input.text = "";
                    } else {
                        App.paste-join();
                    }
                }
            }
        }
    }
}

component TopBar inherits Rectangle {
    // Janela estreita: o status da rede vira só a bolinha.
    in property <bool> compact;
    height: 44px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Logo { }
        }
        Text { text: "AntiJanja"; font-size: Theme.text-lg; font-weight: 800; letter-spacing: -0.3px; color: Theme.fg; vertical-alignment: center; accessible-role: none; }
        HorizontalLayout {
            padding-left: 16px;
            spacing: 4px;
            alignment: start;
            accessible-role: tab-list;
            VerticalLayout {
                alignment: center;
                Tab { label: "Início"; target: "home"; }
            }
            if App.live : VerticalLayout {
                alignment: center;
                Tab { label: "Transmitindo"; target: "host"; live-dot: true; count: App.host-viewers; }
            }
            VerticalLayout {
                alignment: center;
                Tab { label: "Assistindo"; target: "watch"; count: App.watch-count; }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-left: 8px;
            padding-right: 8px;
            VerticalLayout {
                alignment: center;
                CodeField {
                    min-width: 200px;
                    preferred-width: 400px;
                    max-width: 400px;
                    horizontal-stretch: 1;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                LiveDot {
                    kind: App.net == "ok" ? "live" : App.net == "err" ? "err" : "warn";
                    accessible-role: text;
                    accessible-label: App.net == "ok" ? "Rede P2P conectada" : App.net == "err" ? "Sem rede P2P" : "Entrando na rede P2P";
                }
            }
            if !root.compact : Text {
                text: App.net == "ok" ? "Rede P2P conectada" : App.net == "err" ? "Sem rede P2P" : "Entrando na rede P2P";
                font-size: Theme.text-sm;
                color: Theme.muted-fg;
                vertical-alignment: center;
                accessible-role: none;
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    size: "md";
                    kind: "ghost";
                    icon-only: true;
                    icon: Theme.dark ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                    has-icon: true;
                    accessible-label: Theme.dark ? "Usar tema claro" : "Usar tema escuro";
                    clicked => { App.toggle-theme(); }
                }
            }
        }
    }
}

// Aparece com um fade (avisos e cartões flutuantes).
component FadeIn inherits Rectangle {
    property <bool> shown: false;
    init => { root.shown = true; }
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.normal; easing: ease-out; }
}

// Código de live ou de amigo que apareceu na área de transferência: "Entrar" ou dispensar.
component ClipCard inherits FadeIn {
    height: 48px;
    width: row.preferred-width;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: App.clip-friend ? Theme.friend-solid : Theme.primary;
    background: Theme.card;
    drop-shadow-blur: Theme.shadow-sm-blur;
    drop-shadow-offset-y: Theme.shadow-sm-y;
    drop-shadow-color: Theme.shadow-sm;
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { source: @image-url("icons/paste.svg"); tint: App.clip-friend ? Theme.friend-text : Theme.live-text; width: 16px; height: 16px; }
        }
        Text {
            text: App.clip-friend ? "Código de amigo copiado" : "Código copiado";
            font-size: Theme.text-base;
            font-weight: 600;
            color: Theme.fg;
            vertical-alignment: center;
        }
        Text {
            text: App.clip-code;
            font-size: Theme.text-sm;
            color: Theme.muted-fg;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: "primary";
                size: "md";
                bold: true;
                text: App.clip-friend ? "Adicionar" : "Entrar";
                clicked => { App.clip-use(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: "ghost";
                size: "md";
                icon-only: true;
                icon: @image-url("icons/x.svg");
                has-icon: true;
                icon-size: 12px;
                accessible-label: "Dispensar";
                clicked => { App.clip-dismiss(); }
            }
        }
    }
}

component Toasts inherits VerticalLayout {
    spacing: 8px;
    alignment: start;
    if App.clip-code != "" && !App.fullscreen : HorizontalLayout {
        alignment: center;
        ClipCard { }
    }
    for t in App.toasts : HorizontalLayout {
        alignment: center;
        FadeIn {
            width: Math.min(row.preferred-width, 520px);
            height: 44px;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.card;
            drop-shadow-blur: Theme.shadow-sm-blur;
            drop-shadow-offset-y: Theme.shadow-sm-y;
            drop-shadow-color: Theme.shadow-sm;
            accessible-role: text;
            accessible-label: t.text;
            row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 16px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    LiveDot { kind: t.kind == "err" ? "err" : t.kind == "ok" ? "live" : "muted"; }
                }
                Text {
                    text: t.text;
                    font-size: Theme.text-base;
                    color: Theme.fg;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

component UpdateOverlay inherits Rectangle {
    background: Theme.bg.with-alpha(0.97);
    TouchArea { }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 320px;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("icons/download.svg");
                        tint: Theme.primary;
                        width: 32px;
                        height: 32px;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Atualizando para a versão " + App.update-version; font-size: Theme.text-lg; font-weight: 600; color: Theme.fg; horizontal-alignment: center; }
                    Text { text: "O AntiJanja reinicia sozinho quando terminar."; font-size: Theme.text-base; color: Theme.muted-fg; horizontal-alignment: center; }
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.muted;
                    clip: true;
                    accessible-role: progress-indicator;
                    accessible-label: "Progresso da atualização";
                    accessible-value: App.update-progress < 0 ? "" : Math.round(App.update-progress * 100) + "%";
                    Rectangle {
                        x: App.update-progress < 0 ? (parent.width * 1.3) * Math.mod(animation-tick() / 1.4s, 1) - parent.width * 0.3 : 0;
                        width: App.update-progress < 0 ? parent.width * 0.3 : parent.width * App.update-progress;
                        height: 100%;
                        border-radius: 3px;
                        background: Theme.primary;
                    }
                }
                if App.update-progress >= 0 : Text {
                    text: Math.round(App.update-progress * 100) + "%";
                    font-size: Theme.text-sm;
                    color: Theme.muted-fg;
                    font-family: Theme.mono;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// Senha para assistir uma transmissão com senha.
component PasswordDialog inherits Dialog {
    card-width: 380px;
    dismissed => { App.cancel-password(); }
    VerticalLayout {
        padding: 22px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Icon { source: @image-url("icons/lock.svg"); tint: Theme.primary; width: 18px; height: 18px; }
            }
            Text { text: "Essa transmissão tem senha"; font-size: Theme.text-lg; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
        }
        Text { text: "Peça a senha para quem está transmitindo."; font-size: Theme.text-base; color: Theme.muted-fg; wrap: word-wrap; }
        field := TextField {
            secret: true;
            placeholder: "Senha";
            accepted(t) => { App.submit-password(t); }
            init => { self.focus-input(); }
        }
        if App.password-error != "" : Text { text: App.password-error; font-size: Theme.text-sm; color: Theme.destructive; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn { kind: "ghost"; text: "Cancelar"; clicked => { App.cancel-password(); } }
            Btn { kind: "primary"; text: "Assistir"; clicked => { App.submit-password(field.text); } }
        }
    }
}

// Bloco dentro de um diálogo (no lugar de uma caixa com borda).
component Panel inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.raised;
}

// Conta, em três abas: código de amigo; aparelhos (vincular, desvincular, entrar por
// outro aparelho); recuperação (a frase, e entrar com a frase de outra conta).
component AccountDialog inherits Dialog {
    card-width: 520px;
    // Abre na aba do que estiver em andamento (vincular, restaurar).
    property <string> tab: "code";
    init => {
        if (App.link-mode != "") {
            self.tab = "devices";
        } else if (App.account-restore) {
            self.tab = "recovery";
        }
    }
    dismissed => { App.close-account(); }
    Flickable {
        preferred-height: box.preferred-height;
        content-height: box.preferred-height;
        box := VerticalLayout {
            width: parent.width;
            padding: 24px;
            spacing: 20px;
            HorizontalLayout {
                spacing: 14px;
                Cover {
                    width: 48px;
                    height: 48px;
                    border-radius: Theme.radius-lg;
                    idx: 1;
                    initials: App.my-initials;
                    text-size: 17px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    horizontal-stretch: 1;
                    Text { text: App.my-name; font-size: Theme.text-xl; font-weight: 700; color: Theme.fg; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        KeyGlyphs { glyphs: App.my-glyphs; size: 10px; }
                        Text { text: App.my-fingerprint; font-size: Theme.text-sm; color: Theme.soft-fg; font-family: Theme.mono; vertical-alignment: center; }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    Btn {
                        size: "md";
                        kind: "ghost";
                        icon-only: true;
                        icon: @image-url("icons/x.svg");
                        has-icon: true;
                        icon-size: 13px;
                        accessible-label: "Fechar";
                        clicked => { App.close-account(); }
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                Segmented {
                    options: [
                        { value: "code", label: "Código de amigo" },
                        { value: "devices", label: "Aparelhos" },
                        { value: "recovery", label: "Recuperação" }
                    ];
                    value: root.tab;
                    selected(v) => { root.tab = v; }
                }
            }

            // ---- Código de amigo
            if root.tab == "code" : VerticalLayout {
                spacing: 10px;
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-md;
                    background: Theme.muted;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: App.my-friend-code;
                            font-size: Theme.text-sm;
                            font-family: Theme.mono;
                            color: Theme.soft-fg;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                kind: "primary";
                                size: "md";
                                icon: @image-url("icons/copy.svg");
                                has-icon: true;
                                text: "Copiar";
                                clicked => { App.copy-friend-code(); }
                            }
                        }
                    }
                }
                Text {
                    text: "Mande para quem você quer adicionar. Quem colar o código no campo do topo te manda um pedido de amizade.";
                    font-size: Theme.text-sm;
                    color: Theme.muted-fg;
                    wrap: word-wrap;
                }
            }

            // ---- Aparelhos
            if root.tab == "devices" : VerticalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 4px;
                    for d in App.account-devices : HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            LiveDot { kind: d.current ? "live" : "muted"; }
                        }
                        Text { text: d.name; font-size: Theme.text-base; font-weight: d.current ? 600 : 400; color: Theme.fg; vertical-alignment: center; overflow: elide; }
                        Text {
                            text: d.current ? (App.account-primary ? "· este, principal" : "· este") : "";
                            font-size: Theme.text-base;
                            color: Theme.muted-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if App.account-primary && !d.current : VerticalLayout {
                            alignment: center;
                            Btn {
                                kind: "ghost";
                                size: "sm";
                                text: "Desvincular";
                                clicked => { App.link-revoke(d.dev); }
                            }
                        }
                    }
                    if App.account-primary && App.link-mode == "" : HorizontalLayout {
                        alignment: start;
                        padding-top: 4px;
                        Btn {
                            kind: "outline";
                            size: "md";
                            icon: @image-url("icons/plus.svg");
                            has-icon: true;
                            text: "Vincular outro aparelho";
                            clicked => { App.link-add(); }
                        }
                    }
                    if !App.account-primary : Text {
                        text: "Para vincular ou desvincular aparelhos, use o aparelho principal.";
                        font-size: Theme.text-sm;
                        color: Theme.muted-fg;
                        wrap: word-wrap;
                    }
                }

                // Principal: digitar o código do aparelho novo e conferir a figura.
                if App.link-mode == "add" : Panel {
                    height: add.preferred-height;
                    add := VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "Vincular aparelho"; font-size: Theme.text-md; font-weight: 600; color: Theme.fg; }
                        if App.link-offer-name == "" : Text {
                            text: "No aparelho novo, abra a conta › “Aparelhos” › “Entrar por outro aparelho”, e digite aqui o código que aparecer lá.";
                            font-size: Theme.text-sm;
                            color: Theme.soft-fg;
                            wrap: word-wrap;
                        }
                        if App.link-offer-name == "" : HorizontalLayout {
                            spacing: 8px;
                            code := TextField {
                                mono: true;
                                placeholder: "Código de 6 números";
                                accepted(t) => { App.link-lookup(t); }
                                init => { self.focus-input(); }
                            }
                            Btn {
                                kind: "primary";
                                text: App.link-busy ? "Procurando…" : "Procurar";
                                busy: App.link-busy;
                                enabled: !App.link-busy;
                                clicked => { App.link-lookup(code.text); }
                            }
                        }
                        if App.link-offer-name != "" : VerticalLayout {
                            spacing: 10px;
                            Text { text: "Encontrado: “" + App.link-offer-name + "” pedindo para entrar."; font-size: Theme.text-base; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                KeyGlyphs { glyphs: App.link-offer-glyphs; size: 18px; }
                                Text { text: "A figura é a mesma nos dois aparelhos?"; font-size: Theme.text-base; color: Theme.soft-fg; vertical-alignment: center; }
                            }
                        }
                        if App.link-error != "" : Text { text: App.link-error; font-size: Theme.text-sm; color: Theme.destructive; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Btn { kind: "ghost"; size: "md"; text: App.link-offer-name == "" ? "Cancelar" : "Não é a mesma"; clicked => { App.link-cancel(); } }
                            if App.link-offer-name != "" : Btn {
                                kind: "primary";
                                size: "md";
                                text: App.link-busy ? "Vinculando…" : "É a mesma, vincular";
                                busy: App.link-busy;
                                enabled: !App.link-busy;
                                clicked => { App.link-confirm(); }
                            }
                        }
                    }
                }

                // Este PC esperando o principal digitar o código.
                if App.link-mode == "join" : Panel {
                    height: join.preferred-height;
                    join := VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text {
                            text: "No aparelho que já tem a conta (o principal), abra a conta › “Aparelhos” › “Vincular outro aparelho” e digite:";
                            font-size: Theme.text-base;
                            color: Theme.soft-fg;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 60px;
                            border-radius: Theme.radius-md;
                            background: Theme.card;
                            Text {
                                text: App.link-code;
                                font-size: Theme.text-2xl;
                                font-family: Theme.mono;
                                letter-spacing: 6px;
                                color: Theme.live-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: "Figura deste pedido:"; font-size: Theme.text-sm; color: Theme.muted-fg; vertical-alignment: center; }
                            KeyGlyphs { glyphs: App.link-glyphs; size: 18px; }
                        }
                        if App.link-error == "" : Text {
                            text: "Esperando o outro aparelho… O código vale por 5 minutos. A conta atual deste PC sai daqui quando vincular.";
                            font-size: Theme.text-sm;
                            color: Theme.muted-fg;
                            wrap: word-wrap;
                        }
                        if App.link-error != "" : Text { text: App.link-error; font-size: Theme.text-sm; color: Theme.destructive; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Btn { kind: "ghost"; size: "md"; text: "Cancelar"; clicked => { App.link-cancel(); } }
                            if App.link-error != "" : Btn { kind: "primary"; size: "md"; text: "Gerar outro código"; clicked => { App.link-start(); } }
                        }
                    }
                }

                if App.link-mode == "" && !App.account-restore : VerticalLayout {
                    spacing: 8px;
                    Divider { }
                    Rectangle { height: 4px; }
                    Eyebrow { text: "ENTRAR COM UMA CONTA QUE JÁ EXISTE"; }
                    Text {
                        text: "Use a conta de outro PC aqui. A conta atual deste PC sai dele.";
                        font-size: Theme.text-sm;
                        color: Theme.muted-fg;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Btn {
                            kind: "outline";
                            size: "md";
                            text: "Entrar por outro aparelho";
                            clicked => { App.link-start(); }
                        }
                    }
                }
            }

            // ---- Recuperação
            if root.tab == "recovery" : VerticalLayout {
                spacing: 16px;
                if App.account-primary : Rectangle {
                    height: phrase.preferred-height;
                    border-radius: Theme.radius-lg;
                    background: Theme.warn.with-alpha(0.1);
                    phrase := VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { source: @image-url("icons/lock.svg"); tint: Theme.warn-text; width: 15px; height: 15px; }
                            }
                            Text { text: "Frase de recuperação"; font-size: Theme.text-base; font-weight: 600; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
                            Btn {
                                kind: "outline";
                                size: "sm";
                                icon: @image-url("icons/eye.svg");
                                has-icon: true;
                                text: App.account-phrase.length > 0 ? "Esconder" : "Mostrar";
                                clicked => { App.show-phrase(App.account-phrase.length == 0); }
                            }
                        }
                        Text {
                            text: "24 palavras que recriam sua conta em outro PC. Anote em papel. Sem a frase e sem este PC, a conta não tem volta: não existe servidor para recuperar.";
                            font-size: Theme.text-sm;
                            color: Theme.soft-fg;
                            wrap: word-wrap;
                        }
                        if App.account-phrase.length > 0 : Rectangle {
                            height: 6 * 24px;
                            for w[i] in App.account-phrase : Text {
                                x: Math.mod(i, 4) * (parent.width / 4);
                                y: Math.floor(i / 4) * 24px;
                                width: parent.width / 4;
                                height: 24px;
                                vertical-alignment: center;
                                text: (i + 1) + ". " + w;
                                font-size: Theme.text-sm;
                                font-family: Theme.mono;
                                color: Theme.fg;
                            }
                        }
                    }
                }
                if !App.account-primary : Text {
                    text: "A frase de recuperação fica no aparelho onde a conta foi criada.";
                    font-size: Theme.text-sm;
                    color: Theme.muted-fg;
                    wrap: word-wrap;
                }

                if !App.account-restore && App.link-mode != "join" : VerticalLayout {
                    spacing: 8px;
                    Divider { }
                    Rectangle { height: 4px; }
                    Eyebrow { text: "ENTRAR COM A FRASE DE OUTRA CONTA"; }
                    HorizontalLayout {
                        alignment: start;
                        Btn {
                            kind: "outline";
                            size: "md";
                            text: "Usar a frase de recuperação";
                            clicked => { App.restore-mode(true); }
                        }
                    }
                }

                if App.account-restore : VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Digite as 24 palavras da outra conta. A conta atual sai deste PC: se ela for sua, anote a frase dela antes.";
                        font-size: Theme.text-sm;
                        color: Theme.warn-text;
                        wrap: word-wrap;
                    }
                    field := TextField {
                        placeholder: "24 palavras separadas por espaço";
                        accepted(t) => { App.restore-account(t); }
                        init => { self.focus-input(); }
                    }
                    if App.account-error != "" : Text { text: App.account-error; font-size: Theme.text-sm; color: Theme.destructive; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Btn { kind: "ghost"; size: "md"; text: "Cancelar"; clicked => { App.restore-mode(false); } }
                        Btn { kind: "primary"; size: "md"; text: "Entrar"; clicked => { App.restore-account(field.text); } }
                    }
                }
            }
        }
    }
}


// Convite de um amigo para assistir a live dele.
component InviteCard inherits FadeIn {
    width: 360px;
    height: box.preferred-height;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.primary.with-alpha(0.4);
    background: Theme.card;
    drop-shadow-blur: Theme.shadow-lg-blur;
    drop-shadow-offset-y: Theme.shadow-lg-y;
    drop-shadow-color: Theme.shadow-lg;
    box := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Icon { source: @image-url("icons/radio.svg"); tint: Theme.primary; width: 20px; height: 20px; }
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: App.invite-name + " te convidou para assistir"; font-size: Theme.text-md; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                if App.invite-title != "" : Text { text: App.invite-title; font-size: Theme.text-sm; color: Theme.muted-fg; overflow: elide; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Btn { kind: "primary"; size: "md"; horizontal-stretch: 1; text: "Assistir"; clicked => { App.invite-accept(); } }
            Btn { kind: "outline"; size: "md"; horizontal-stretch: 1; text: "Agora não"; clicked => { App.invite-dismiss(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: App.title;
    icon: @image-url("../assets/icons/128x128.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 940px;
    min-height: 620px;
    background: Theme.bg;
    default-font-family: Theme.sans;

    changed width => { App.layout-changed(); }
    changed height => { App.layout-changed(); }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.F11) {
                App.key-f11();
                return accept;
            }
            if (e.text == Key.Escape) {
                App.key-escape();
                return accept;
            }
            // Ctrl+V fora de um campo de texto (os campos ficam com o colar deles).
            if (e.modifiers.control && (e.text == "v" || e.text == "V")) {
                App.key-paste();
                return accept;
            }
            reject
        }

        VerticalLayout {
            if !App.fullscreen : TopBar { compact: App.narrow; }
            Rectangle {
                vertical-stretch: 1;
                if App.view == "home" : HomeView { }
                if App.view == "host" : HostView { }
                if App.view == "watch" : WatchView { }
            }
        }
    }

    if App.picker != "" : SourcePicker {
        width: 100%;
        height: 100%;
    }

    Toasts {
        x: 0;
        y: 56px;
        width: root.width;
    }

    if App.invite-code != "" : InviteCard {
        x: root.width - self.width - 20px;
        y: 56px;
    }

    if App.account-open : AccountDialog {
        width: 100%;
        height: 100%;
    }

    if App.password-prompt : PasswordDialog {
        width: 100%;
        height: 100%;
    }

    if App.update-version != "" : UpdateOverlay {
        width: 100%;
        height: 100%;
    }
}
