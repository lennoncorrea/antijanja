// Assistindo: várias transmissões lado a lado.
// A posição de cada tile vem do Rust, que põe o player nativo exatamente sobre a
// área de vídeo. Por isso as alturas do cabeçalho (44) e do rodapé (40) são fixas.
import { Theme } from "theme.slint";
import { App, Tile, MenuOption } from "state.slint";
import { Badge, Btn, Cover, EmptyState, Icon, Slider, Spinner, TextField } from "widgets.slint";

component AddBar inherits Rectangle {
    height: 60px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text { text: "Assistindo"; font-size: 16px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
        if App.watch-count > 0 : VerticalLayout {
            alignment: center;
            Badge { text: App.watch-count; }
        }
        if App.has-focus : VerticalLayout {
            alignment: center;
            Btn {
                height: 32px;
                kind: "outline";
                font-size: 13px;
                pad: 12px;
                text: "Ver todas";
                icon: @image-url("icons/grid.svg");
                has-icon: true;
                icon-size: 14px;
                clicked => { App.unfocus(); }
            }
        }
        Rectangle { }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                code := TextField {
                    width: 340px;
                    mono: true;
                    placeholder: "Cole outro código (AJ3.)";
                    accepted(t) => {
                        App.join(t);
                        self.text = "";
                    }
                }
                Btn {
                    width: 40px;
                    kind: "outline";
                    icon-only: true;
                    icon: @image-url("icons/paste.svg");
                    has-icon: true;
                    accessible-label: "Colar e entrar";
                    clicked => { App.paste-join(); }
                }
                Btn {
                    kind: "primary";
                    text: "Adicionar";
                    icon: @image-url("icons/plus.svg");
                    has-icon: true;
                    clicked => {
                        if (code.text != "") {
                            App.join(code.text);
                            code.text = "";
                        }
                    }
                }
            }
        }
    }
}

component Step inherits HorizontalLayout {
    in property <string> label;
    // 0 = feito, 1 = agora, 2 = depois
    in property <int> phase;
    spacing: 10px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 16px;
            height: 16px;
            if root.phase == 0 : Icon {
                source: @image-url("icons/check.svg");
                tint: Theme.live-text;
            }
            if root.phase == 1 : Spinner { }
            if root.phase == 2 : Rectangle {
                x: 5px;
                y: 5px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.muted-fg.with-alpha(0.4);
            }
        }
    }
    Text {
        text: root.label;
        font-size: 13px;
        color: root.phase == 1 ? Theme.fg : Theme.muted-fg;
        vertical-alignment: center;
    }
}

// Selo da geração de quadros ("FG 2x").
component GenTag inherits Rectangle {
    in property <string> text;
    height: 18px;
    width: label.preferred-width + 12px;
    border-radius: 4px;
    background: Theme.feature-bg;
    border-width: 1px;
    border-color: Theme.primary.with-alpha(0.35);
    label := Text {
        text: root.text;
        font-family: Theme.mono;
        font-size: 10px;
        font-weight: 600;
        color: Theme.feature-ink;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Linha do menu principal: nome, valor atual e seta.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> tag;
    callback clicked();
    height: 44px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.muted : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Text { text: root.label; font-size: 13px; font-weight: 500; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: root.value; font-size: 12px; color: Theme.muted-fg; vertical-alignment: center; }
        if root.tag != "" : VerticalLayout { alignment: center; GenTag { text: root.tag; } }
        VerticalLayout {
            alignment: center;
            Icon { source: @image-url("icons/chevron-right.svg"); tint: Theme.muted-fg; width: 14px; height: 14px; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Opção de um submenu: marca de escolhida, nome, selo e observação.
component OptionRow inherits Rectangle {
    in property <MenuOption> o;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: o.selected ? Theme.accent : ta.has-hover ? Theme.muted : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 16px;
            if root.o.selected : Icon { source: @image-url("icons/check.svg"); tint: Theme.primary; width: 14px; height: 14px; }
        }
        Text { text: root.o.label; font-size: 13px; font-weight: root.o.selected ? 600 : 400; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
        if root.o.tag != "" : VerticalLayout { alignment: center; GenTag { text: root.o.tag; } }
        if root.o.note != "" : Text { text: root.o.note; font-size: 11px; color: Theme.muted-fg; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component MenuBack inherits Rectangle {
    in property <string> title;
    height: 40px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.muted : transparent;
    HorizontalLayout {
        padding-left: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { source: @image-url("icons/chevron-left.svg"); tint: Theme.muted-fg; width: 14px; height: 14px; }
        }
        Text { text: root.title; font-size: 13px; font-weight: 600; color: Theme.fg; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { App.menu-go("main"); } }
}

component MenuDivider inherits Rectangle {
    height: 9px;
    Rectangle { x: 6px; width: parent.width - 12px; height: 1px; background: Theme.border; }
}

// Menu de engrenagem: qualidade e fps da stream.
// Altura: a do conteúdo. Muda (troca de painel, texto que quebra) avisando o Rust, que
// ajusta o buraco no vídeo. Sem sombra: em volta do menu fica o vídeo (janela nativa),
// então ela nunca aparecia, mas custava para desenhar.
component GearMenu inherits Rectangle {
    width: 300px;
    height: lay.preferred-height;
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.input;
    init => { App.menu-resized(self.height); }
    changed height => { App.menu-resized(self.height); }
    TouchArea { }
    lay := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        alignment: start;
        if App.menu-panel == "main" : MenuRow {
            label: "Qualidade";
            value: App.menu-quality-label;
            clicked => { App.menu-go("quality"); }
        }
        if App.menu-panel == "main" : MenuRow {
            label: "FPS";
            value: App.menu-fps-label;
            tag: App.menu-gen-tag;
            clicked => { App.menu-go("fps"); }
        }
        if App.menu-panel == "main" : MenuDivider { }
        if App.menu-panel == "main" : Text {
            text: App.menu-info;
            font-size: 11px;
            color: Theme.muted-fg;
            wrap: word-wrap;
        }
        if App.menu-panel == "fps" : MenuBack { title: "FPS para assistir"; }
        if App.menu-panel == "fps" : MenuDivider { }
        if App.menu-panel == "fps" : VerticalLayout {
            spacing: 2px;
            for o in App.menu-fps : OptionRow { o: o; clicked => { App.set-view-fps(o.value); } }
        }
        if App.menu-panel == "fps" : MenuDivider { }
        if App.menu-panel == "fps" : Text {
            text: App.menu-fps-hint;
            font-size: 11px;
            color: Theme.muted-fg;
            wrap: word-wrap;
        }
        if App.menu-panel == "quality" : MenuBack { title: "Qualidade"; }
        if App.menu-panel == "quality" : MenuDivider { }
        if App.menu-panel == "quality" : VerticalLayout {
            spacing: 2px;
            for o in App.menu-quality : OptionRow { o: o; clicked => { App.pick-quality(o.value); } }
        }
        if App.menu-panel == "quality" : MenuDivider { }
        if App.menu-panel == "quality" : Text {
            text: "Auto: a resolução acompanha a sua rede. Uma fixa menor economiza internet.";
            font-size: 11px;
            color: Theme.muted-fg;
            wrap: word-wrap;
        }
    }
}

component TileView inherits Rectangle {
    in property <Tile> t;
    property <bool> bare: App.fullscreen;
    background: Theme.card;
    border-radius: bare ? 0px : 12px;
    border-width: bare ? 0px : 1px;
    border-color: Theme.border;
    clip: true;
    VerticalLayout {
        if root.t.chrome : Rectangle {
            height: 44px;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Cover {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        initials: root.t.initials;
                        text-size: 11px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.t.name; font-size: 13px; font-weight: 600; color: Theme.fg; overflow: elide; }
                    Text {
                        text: root.t.watching ? "Ao vivo, P2P" : "Entrando";
                        font-size: 12px;
                        color: root.t.watching ? Theme.live-text : Theme.muted-fg;
                    }
                }
                Rectangle { }
                if root.t.watching && root.t.res != "" && root.width > 480px : VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        Badge { text: root.t.res; }
                        if root.t.gen-tag != "" : VerticalLayout { alignment: center; GenTag { text: "FG " + root.t.gen-tag; } }
                        Badge { text: root.t.rate; }
                        if root.t.ping != "" : Badge {
                            text: root.t.ping;
                            bg: root.t.ping-warn ? Theme.warn : Theme.muted;
                            ink: root.t.ping-warn ? #000000 : Theme.fg;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        // Em tela cheia só há uma stream: "ampliar" não faz sentido.
                        if !App.fullscreen : Btn {
                            width: 32px;
                            height: 32px;
                            kind: "ghost";
                            icon-only: true;
                            icon: root.t.focused ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
                            has-icon: true;
                            accessible-label: root.t.focused ? "Voltar para a grade" : "Ampliar";
                            clicked => { App.toggle-focus(root.t.id); }
                        }
                        Btn {
                            width: 32px;
                            height: 32px;
                            kind: "ghost";
                            icon-only: true;
                            icon: App.fullscreen ? @image-url("icons/fullscreen-exit.svg") : @image-url("icons/fullscreen.svg");
                            has-icon: true;
                            accessible-label: App.fullscreen ? "Sair da tela cheia (Esc)" : "Tela cheia (F11 ou duplo clique)";
                            clicked => { App.toggle-fullscreen(root.t.id); }
                        }
                        Btn {
                            width: 32px;
                            height: 32px;
                            kind: "ghost";
                            icon-only: true;
                            icon: @image-url("icons/x.svg");
                            has-icon: true;
                            accessible-label: "Parar de assistir";
                            clicked => { App.leave(root.t.id); }
                        }
                    }
                }
            }
        }

        // Área de vídeo: o player nativo fica por cima quando conectado.
        Rectangle {
            vertical-stretch: 1;
            background: root.t.watching ? #000000 : Theme.bg;
            if !root.t.watching : VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        spacing: 10px;
                        Step { label: "Preparando a conexão"; phase: root.t.step > 0 ? 0 : root.t.step == 0 ? 1 : 2; }
                        Step { label: "Mandando o pedido pela rede P2P"; phase: root.t.step > 1 ? 0 : root.t.step == 1 ? 1 : 2; }
                        Step { label: "Esperando o host responder"; phase: root.t.step > 2 ? 0 : root.t.step == 2 ? 1 : 2; }
                        Step { label: "Conectando direto ao host"; phase: root.t.step > 3 ? 0 : root.t.step == 3 ? 1 : 2; }
                    }
                }
            }
        }

        if root.t.chrome && root.t.watching : Rectangle {
            height: 40px;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Btn {
                        width: 32px;
                        height: 32px;
                        kind: "ghost";
                        icon-only: true;
                        icon: root.t.muted || root.t.volume == 0 ? @image-url("icons/volume-x.svg") : @image-url("icons/volume.svg");
                        has-icon: true;
                        accessible-label: root.t.muted ? "Ativar som" : "Silenciar";
                        clicked => { App.toggle-mute(root.t.id); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Slider {
                        width: 128px;
                        value: root.t.muted ? 0 : root.t.volume;
                        changed(v) => { App.set-volume(root.t.id, v); }
                    }
                }
                Text {
                    text: (root.t.muted ? 0 : root.t.volume) + "%";
                    font-size: 12px;
                    color: Theme.muted-fg;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                }
            }
            // Engrenagem: qualidade e fps. O selo mostra o multiplicador da geração de quadros.
            gear := Rectangle {
                x: parent.width - self.width - 8px;
                y: (parent.height - self.height) / 2;
                height: 32px;
                width: gear-row.preferred-width + 16px;
                border-radius: 8px;
                background: App.menu-tile == root.t.id ? Theme.accent : gear-ta.has-hover ? Theme.muted : transparent;
                gear-row := HorizontalLayout {
                    x: 8px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: @image-url("icons/settings.svg");
                            tint: App.menu-tile == root.t.id || gear-ta.has-hover ? Theme.fg : Theme.muted-fg;
                            width: 16px;
                            height: 16px;
                        }
                    }
                    if root.t.gen-tag != "" : Text {
                        text: root.t.gen-tag;
                        font-family: Theme.mono;
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.feature-ink;
                        vertical-alignment: center;
                    }
                }
                // Abre ao apertar (não ao soltar), como os menus de player de vídeo: o
                // clique leva ~100 ms entre apertar e soltar.
                gear-ta := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            App.toggle-menu(root.t.id);
                        }
                    }
                }
                accessible-role: button;
                accessible-action-default => { App.toggle-menu(root.t.id); }
                accessible-label: "Configurações da stream (qualidade e fps)";
            }
        }
    }
}

export component WatchView inherits Rectangle {
    VerticalLayout {
        if !App.fullscreen : AddBar { }
        Rectangle {
            vertical-stretch: 1;
            if App.tiles.length == 0 : VerticalLayout {
                alignment: center;
                padding: 24px;
                HorizontalLayout {
                    alignment: center;
                    EmptyState {
                        width: 420px;
                        icon: @image-url("icons/tv.svg");
                        title: "Nenhuma transmissão aberta";
                        body: "Cole um código acima para assistir. Dá para abrir várias ao mesmo tempo, e elas aparecem lado a lado.";
                    }
                }
            }
            for t in App.tiles : TileView {
                x: t.x;
                y: t.y;
                width: t.w;
                height: t.h;
                t: t;
            }
            // Clique fora do menu fecha.
            if App.menu-tile != "" : TouchArea {
                clicked => { App.close-menu(); }
            }
            if App.menu-tile != "" : GearMenu {
                x: App.menu-x;
                y: App.menu-bottom - self.height;
            }
        }
    }
}
