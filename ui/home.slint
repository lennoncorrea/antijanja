// Início: quem está ao vivo agora (mural público na DHT) + coluna de ações.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { App, Stream, FriendItem, RequestItem } from "state.slint";
import { Btn, Card, Cover, Divider, EmptyState, Eyebrow, Icon, KeyGlyphs, Tag } from "widgets.slint";

// Quantos assistem (com o ícone de olho) e há quanto tempo.
component Meta inherits HorizontalLayout {
    in property <int> viewers;
    in property <string> since;
    in property <length> size: 11px;
    spacing: 5px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Icon { source: @image-url("icons/eye.svg"); tint: Theme.muted-fg; width: root.size + 2px; height: root.size + 2px; }
    }
    Text { text: root.viewers + " · " + root.since; font-size: root.size; color: Theme.muted-fg; font-family: Theme.mono; overflow: elide; vertical-alignment: center; }
}

// Etiqueta "AO VIVO" (ciano).
component LivePill inherits Rectangle {
    width: live.preferred-width + 16px;
    height: 22px;
    border-radius: 4px;
    background: Theme.live;
    live := Text {
        x: 8px;
        height: 100%;
        vertical-alignment: center;
        text: "AO VIVO";
        color: Theme.primary-fg;
        font-family: Theme.mono;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.9px;
    }
}

component Featured inherits Card {
    in property <Stream> s;
    height: 216px;
    clip: true;
    HorizontalLayout {
        Cover {
            max-width: 380px;
            horizontal-stretch: 0.8;
            big: true;
            friend: root.s.friend;
            initials: root.s.initials;
            text-size: 88px;
            LivePill { x: 12px; y: 12px; }
            Tag {
                x: 12px;
                y: parent.height - self.height - 12px;
                text: root.s.quality;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 22px;
            padding-left: 24px;
            spacing: 10px;
            Eyebrow {
                text: root.s.friend ? (root.s.friends-only ? "AMIGO · SÓ AMIGOS" : "AMIGO AO VIVO") : "MAIS ASSISTIDA";
                color: root.s.friend ? Theme.friend-text : Theme.muted-fg;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: root.s.name; font-size: 26px; font-weight: 700; color: Theme.fg; overflow: elide; }
                if root.s.locked : VerticalLayout {
                    alignment: center;
                    Icon { source: @image-url("icons/lock.svg"); tint: Theme.muted-fg; width: 18px; height: 18px; }
                }
            }
            Text { text: root.s.title; font-size: 15px; color: Theme.soft-fg; overflow: elide; }
            Meta { viewers: root.s.viewers; since: root.s.since; size: 12px; }
            Rectangle { }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if !root.s.watching : Btn {
                    kind: "primary";
                    bold: true;
                    text: "Assistir";
                    icon: @image-url("icons/play.svg");
                    has-icon: true;
                    icon-size: 13px;
                    clicked => { App.watch(root.s.code); }
                }
                if root.s.watching : Btn {
                    text: "Assistindo";
                    clicked => { App.navigate("watch"); }
                }
                Btn {
                    kind: "outline";
                    text: "Copiar código";
                    clicked => { App.copy-code(root.s.code); }
                }
            }
        }
    }
}

// Uma transmissão na grade. O cartão inteiro abre a live (clique, Enter ou espaço);
// `big`: com poucas lives, dois cartões grandes por linha.
component StreamCard inherits Card {
    in property <Stream> s;
    in property <bool> big;
    property <bool> hot: !root.s.blank && (ta.has-hover || keys.has-focus);
    border-radius: root.big ? 14px : 12px;
    border-color: root.hot ? Theme.primary : Theme.border;
    clip: true;
    opacity: root.s.blank ? 0 : 1;
    accessible-role: button;
    accessible-label: root.s.watching ? "Ver " + root.s.name : "Assistir " + root.s.name;
    accessible-action-default => { root.open(); }

    function open() {
        if (root.s.blank) {
            return;
        }
        if (root.s.watching) {
            App.navigate("watch");
        } else {
            App.watch(root.s.code);
        }
    }

    keys := FocusScope {
        enabled: !root.s.blank;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.open();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: !root.s.blank;
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    VerticalLayout {
        Cover {
            height: root.big ? 190px : 104px;
            idx: root.s.cover;
            friend: root.s.friend;
            initials: root.s.initials;
            text-size: root.big ? 64px : 40px;
            if root.big && !root.s.friend : LivePill { x: 12px; y: 12px; }
            if !root.big && !root.s.friend : Rectangle {
                x: 8px;
                y: 8px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.live;
            }
            if root.s.friend : Tag {
                x: root.big ? 12px : 8px;
                y: root.big ? 12px : 8px;
                bg: Theme.friend-solid;
                ink: Theme.friend-solid-fg;
                text: root.s.friends-only ? "AMIGO · SÓ AMIGOS" : "AMIGO";
            }
            Tag {
                x: parent.width - self.width - (root.big ? 12px : 8px);
                y: parent.height - self.height - (root.big ? 12px : 8px);
                text: root.s.quality;
            }
            if root.s.watching : Tag {
                x: parent.width - self.width - (root.big ? 12px : 8px);
                y: root.big ? 12px : 8px;
                bg: Theme.live;
                ink: Theme.primary-fg;
                text: "ASSISTINDO";
            }
            // Ao passar o mouse (ou com o foco do teclado): o botão de play no meio.
            if root.hot && !root.s.watching : Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: Theme.primary;
                Icon {
                    x: 16px;
                    y: 14px;
                    source: @image-url("icons/play.svg");
                    tint: Theme.primary-fg;
                    width: 15px;
                    height: 15px;
                }
            }
        }
        VerticalLayout {
            padding: root.big ? 16px : 12px;
            padding-top: root.big ? 14px : 10px;
            spacing: root.big ? 4px : 2px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text { text: root.s.name; font-size: root.big ? 17px : 14px; font-weight: root.big ? 700 : 600; color: Theme.fg; overflow: elide; }
                if root.s.locked : VerticalLayout {
                    alignment: center;
                    Icon { source: @image-url("icons/lock.svg"); tint: Theme.muted-fg; width: 13px; height: 13px; accessible-role: image; accessible-label: "Com senha"; }
                }
            }
            Text { text: root.s.title; font-size: root.big ? 13px : 12px; color: root.big ? Theme.soft-fg : Theme.muted-fg; overflow: elide; }
            Meta { viewers: root.s.viewers; since: root.s.since; size: root.big ? 12px : 11px; }
        }
    }
}

component LiveNow inherits ScrollView {
    content-width: self.visible-width;
    VerticalLayout {
        padding: 28px;
        padding-bottom: 24px;
        spacing: 20px;
        alignment: start;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.live;
                        }
                    }
                    Text { text: "NO AR"; font-size: 11px; font-weight: 500; letter-spacing: 1.3px; color: Theme.live-text; font-family: Theme.mono; }
                }
                Text { text: "Ao vivo agora"; font-size: 34px; font-weight: 800; letter-spacing: -1px; color: Theme.fg; }
            }
            VerticalLayout {
                alignment: end;
                padding-bottom: 6px;
                Text {
                    text: App.net == "ok" && !App.public-loading ? App.public-count + (App.public-count == 1 ? " transmissão" : " transmissões") + " · " + App.public-watching + " assistindo" : "";
                    font-size: 13px;
                    color: Theme.muted-fg;
                    font-family: Theme.mono;
                }
            }
            Rectangle { }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 8px;
                    Text { text: App.public-updated; font-size: 12px; color: Theme.muted-fg; }
                }
                VerticalLayout {
                    alignment: end;
                    Btn {
                        kind: "outline";
                        width: 32px;
                        height: 32px;
                        icon-only: true;
                        icon: @image-url("icons/refresh.svg");
                        has-icon: true;
                        icon-size: 14px;
                        accessible-label: "Atualizar agora";
                        enabled: App.net == "ok" && !App.public-busy;
                        clicked => { App.refresh-public(); }
                    }
                }
            }
        }

        if App.net != "ok" : EmptyState {
            title: App.net == "err" ? "Sem acesso à rede P2P" : "Entrando na rede P2P…";
            body: App.net == "err" ? "Confira sua internet. A lista de quem está ao vivo vem dessa rede." : "Leva alguns segundos. Depois a lista aparece aqui.";
        }
        if App.net == "ok" && App.public-loading : EmptyState {
            title: "Lendo quem está ao vivo…";
            body: "Consultando o mural público na rede P2P.";
        }
        if App.net == "ok" && !App.public-loading && App.public-count == 0 : EmptyState {
            title: "Ninguém transmitindo publicamente agora";
            body: App.public-mine ? "A sua transmissão está na lista para os outros." : "Quando alguém começar uma transmissão pública, ela aparece aqui.";
            if !App.public-mine && !App.live : HorizontalLayout {
                alignment: center;
                Btn {
                    kind: "primary";
                    text: "Seja o primeiro";
                    icon: @image-url("icons/radio.svg");
                    has-icon: true;
                    clicked => { App.open-picker("start"); }
                }
            }
        }
        if App.has-featured : Featured {
            s: App.featured;
        }
        for row in App.rows : HorizontalLayout {
            spacing: 12px;
            for s in row.items : StreamCard {
                horizontal-stretch: 1;
                big: row.items.length == 2;
                s: s;
            }
        }
    }
}

// Transmitir: o botão de começar, ou "Você está no ar" quando está transmitindo.
// (Pública ou só com código se escolhe ao começar, e na tela "Transmitindo".)
component StartBlock inherits VerticalLayout {
    vertical-stretch: 0;
    if !App.live : Btn {
        kind: "strong";
        height: 44px;
        bold: true;
        text: "Começar transmissão";
        icon: @image-url("icons/radio.svg");
        has-icon: true;
        clicked => { App.open-picker("start"); }
    }
    if App.live : Card {
        border-radius: 12px;
        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.live;
                    }
                }
                Text { text: "Você está no ar"; font-size: 15px; font-weight: 700; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Icon { source: @image-url("icons/eye.svg"); tint: Theme.muted-fg; width: 14px; height: 14px; }
                }
                Text {
                    text: App.host-viewers;
                    font-size: 12px;
                    color: Theme.muted-fg;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                    accessible-label: App.host-viewers == 1 ? "1 pessoa assistindo" : App.host-viewers + " pessoas assistindo";
                }
            }
            Btn {
                kind: "strong";
                text: "Ver minha transmissão";
                clicked => { App.navigate("host"); }
            }
        }
    }
}

component WatchingList inherits VerticalLayout {
    vertical-stretch: 0;
    spacing: 8px;
    if App.watching-list.length > 0 : Eyebrow { text: "VOCÊ ESTÁ ASSISTINDO"; }
    for w in App.watching-list : Rectangle {
        height: 56px;
        border-radius: 10px;
        border-width: 1px;
        border-color: row.has-hover ? Theme.input : Theme.border;
        background: Theme.card;
        // Atrás do conteúdo: o botão "Adicionar" (no layout) fica por cima e recebe o clique.
        row := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.navigate("watch"); }
        }
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            Cover {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                idx: w.cover;
                initials: w.initials;
                text-size: 13px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text { text: w.name; font-size: 13px; font-weight: 600; color: Theme.fg; overflow: elide; }
                Text { text: w.detail; font-size: 12px; color: Theme.muted-fg; overflow: elide; }
            }
            if w.friend-action != "" : VerticalLayout {
                alignment: center;
                Btn {
                    height: 28px;
                    font-size: 11px;
                    pad: 10px;
                    kind: "outline";
                    text: w.friend-action;
                    clicked => { App.add-friend-code(w.friend); }
                }
            }
        }
    }
}

// Avatar pequeno de amigo, com o ponto de online (verde) ou ao vivo (azul).
component FriendAvatar inherits Rectangle {
    in property <string> initials;
    in property <int> cover;
    in property <bool> online;
    in property <bool> live;
    // Ponto de online (os pedidos mostram o avatar aceso, sem o ponto).
    in property <bool> dot: root.online;
    width: 30px;
    height: 30px;
    Cover {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        idx: root.cover;
        initials: root.initials;
        text-size: 11px;
        opacity: root.online ? 1 : 0.55;
    }
    if root.dot : Rectangle {
        x: 21px;
        y: 21px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        border-width: 2px;
        border-color: Theme.rail;
        background: root.live ? Theme.live : #3ddc97;
    }
}

component RequestRow inherits Rectangle {
    in property <RequestItem> r;
    height: 50px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.friend-solid;
    background: Theme.card;
    HorizontalLayout {
        padding: 9px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            FriendAvatar { initials: root.r.initials; cover: root.r.cover; online: true; dot: false; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text { text: root.r.name; font-size: 13px; font-weight: 600; color: Theme.fg; overflow: elide; }
            Text { text: root.r.detail; font-size: 11px; color: Theme.muted-fg; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                width: 30px;
                height: 30px;
                kind: "primary";
                icon-only: true;
                icon: @image-url("icons/check.svg");
                has-icon: true;
                icon-size: 14px;
                accessible-label: "Aceitar " + root.r.name;
                clicked => { App.friend-accept(root.r.key); }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                width: 30px;
                height: 30px;
                kind: "outline";
                icon-only: true;
                icon: @image-url("icons/x.svg");
                has-icon: true;
                icon-size: 12px;
                accessible-label: "Recusar " + root.r.name;
                clicked => { App.friend-decline(root.r.key); }
            }
        }
    }
}

component FriendRow inherits Rectangle {
    in property <FriendItem> f;
    property <bool> confirm;
    height: 42px;
    border-radius: 8px;
    background: hover.has-hover ? Theme.muted.with-alpha(0.5) : transparent;
    hover := TouchArea {
        changed has-hover => {
            if (!self.has-hover) {
                root.confirm = false;
            }
        }
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            FriendAvatar { initials: root.f.initials; cover: root.f.cover; online: root.f.online; live: root.f.live; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text { text: root.f.name; font-size: 13px; font-weight: 600; color: root.f.online ? Theme.fg : Theme.soft-fg; overflow: elide; }
            Text { text: root.f.detail; font-size: 11px; color: root.f.live ? Theme.live-text : Theme.muted-fg; overflow: elide; }
        }
        if root.f.action != "" && !root.confirm : VerticalLayout {
            alignment: center;
            Btn {
                height: 28px;
                font-size: 11px;
                pad: 10px;
                kind: root.f.live ? "primary" : "outline";
                text: root.f.action;
                clicked => { App.friend-action(root.f.key, root.f.action); }
            }
        }
        // Desfazer amizade: aparece com o mouse em cima e pede confirmação.
        if hover.has-hover && !root.confirm : VerticalLayout {
            alignment: center;
            Btn {
                width: 28px;
                height: 28px;
                kind: "ghost";
                icon-only: true;
                icon: @image-url("icons/user-x.svg");
                has-icon: true;
                icon-size: 13px;
                accessible-label: "Desfazer amizade com " + root.f.name;
                clicked => { root.confirm = true; }
            }
        }
        if root.confirm : VerticalLayout {
            alignment: center;
            Btn {
                height: 28px;
                font-size: 11px;
                pad: 10px;
                kind: "danger";
                text: "Desfazer amizade";
                clicked => {
                    root.confirm = false;
                    App.friend-remove(root.f.key);
                }
            }
        }
    }
}

component FriendsBlock inherits VerticalLayout {
    vertical-stretch: 0;
    spacing: 6px;
    Eyebrow { text: App.friends-count == 0 ? "AMIGOS" : "AMIGOS · " + App.friends-online.length + " ONLINE"; }
    for r in App.friend-requests : RequestRow { r: r; }
    for f in App.friends-online : FriendRow { f: f; }
    for f in App.friends-offline : FriendRow { f: f; }
    if App.friends-offline-count > 0 : HorizontalLayout {
        alignment: start;
        Btn {
            kind: "ghost";
            height: 28px;
            font-size: 12px;
            pad: 6px;
            text: App.friends-show-offline ? "Esconder offline" : "+ " + App.friends-offline-count + " offline";
            clicked => { App.toggle-offline(); }
        }
    }
    for r in App.friend-sent : HorizontalLayout {
        spacing: 8px;
        padding-left: 4px;
        height: 26px;
        Text { text: r.name; font-size: 12px; color: Theme.soft-fg; overflow: elide; vertical-alignment: center; }
        Text { text: r.detail; font-size: 11px; color: Theme.muted-fg; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Btn {
            width: 24px;
            height: 24px;
            kind: "ghost";
            icon-only: true;
            icon: @image-url("icons/x.svg");
            has-icon: true;
            icon-size: 10px;
            accessible-label: "Cancelar pedido para " + r.name;
            clicked => { App.friend-decline(r.key); }
        }
    }
    // Sem amigos: um convite com o atalho para copiar o próprio código.
    if App.friends-count == 0 && App.friend-requests.length == 0 && App.friend-sent.length == 0 : Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.input;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text { text: "Chame seus amigos"; font-size: 14px; font-weight: 600; color: Theme.fg; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                Btn {
                    kind: "primary";
                    height: 36px;
                    font-size: 13px;
                    bold: true;
                    text: "Copiar meu código";
                    icon: @image-url("icons/copy.svg");
                    has-icon: true;
                    icon-size: 14px;
                    clicked => { App.copy-friend-code(); }
                }
            }
        }
    }
}

// Você: o avatar e o botão de conta abrem a janela da conta; o nome se edita no lugar.
component YouCard inherits VerticalLayout {
    vertical-stretch: 0;
    spacing: 14px;
    Divider { }
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Cover {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                idx: 1;
                initials: App.my-initials;
                text-size: 12px;
                accessible-role: button;
                accessible-label: "Abrir minha conta";
                accessible-action-default => { App.open-account(); }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { App.open-account(); }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Rectangle {
                height: 22px;
                border-radius: 5px;
                background: name.has-focus || nameHover.has-hover ? Theme.muted : transparent;
                nameHover := TouchArea {
                    mouse-cursor: text;
                    clicked => { name.focus(); }
                }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 6px;
                    name := TextInput {
                        horizontal-stretch: name.has-focus ? 1 : 0;
                        vertical-alignment: center;
                        single-line: true;
                        text <=> App.my-name;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.fg;
                        selection-background-color: Theme.primary.with-alpha(0.35);
                        accessible-label: "Seu nome";
                        edited => { App.name-edited(self.text); }
                    }
                    if !name.has-focus : VerticalLayout {
                        alignment: center;
                        Icon { source: @image-url("icons/pencil.svg"); tint: Theme.muted-fg; width: 12px; height: 12px; }
                    }
                    if !name.has-focus : Rectangle { horizontal-stretch: 1; }
                }
            }
            HorizontalLayout {
                padding-left: 4px;
                spacing: 6px;
                alignment: start;
                KeyGlyphs { glyphs: App.my-glyphs; size: 8px; }
                Text { text: App.my-fingerprint; font-size: 10px; color: Theme.muted-fg; font-family: Theme.mono; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                kind: "outline";
                width: 32px;
                height: 32px;
                icon-only: true;
                icon: @image-url("icons/user.svg");
                has-icon: true;
                icon-size: 15px;
                accessible-label: "Conta e código de amigo";
                clicked => { App.open-account(); }
            }
        }
    }
}

export component HomeView inherits Rectangle {
    HorizontalLayout {
        LiveNow {
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 300px;
            background: Theme.rail;
            Rectangle {
                x: 0;
                width: 1px;
                background: Theme.border;
            }
            VerticalLayout {
                padding: 20px;
                padding-top: 24px;
                spacing: 18px;
                StartBlock { }
                WatchingList { }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        FriendsBlock { }
                    }
                }
                YouCard { }
            }
        }
    }
}
