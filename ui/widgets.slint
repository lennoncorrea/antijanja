// Componentes reutilizáveis da interface.
//
// Foco do teclado: botões, toggles, abas e sliders entram no Tab. O anel de foco só
// aparece quando o foco veio do teclado (focus-on-click: false), não ao clicar.
import { Theme } from "theme.slint";
import { SelectOption, Glyph } from "state.slint";

export component Eyebrow inherits Text {
    color: Theme.muted-fg;
    font-family: Theme.mono;
    font-size: Theme.text-xs;
    font-weight: 500;
    letter-spacing: 1.1px;
}

export component Icon inherits Image {
    in property <color> tint: Theme.fg;
    colorize: tint;
    width: 16px;
    height: 16px;
    image-fit: contain;
}

export component Spinner inherits Rectangle {
    in property <color> tint: Theme.primary;
    width: 16px;
    height: 16px;
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("icons/loader.svg");
        colorize: root.tint;
        transform-rotation: animation-tick() * 360deg / 0.9s;
    }
}

// Anel do foco do teclado, por fora do elemento pai (que ele ocupa inteiro).
export component FocusRing inherits Rectangle {
    in property <length> radius: Theme.radius-md;
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.radius + 3px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

// Botão. kind: primary | secondary | outline | ghost | strong | danger
// size: lg (40) | md (32) | sm (28)
export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> icon-only: false;
    in property <string> kind: "secondary";
    in property <string> size: "lg";
    in property <bool> enabled: true;
    // Mostra um spinner no lugar do ícone (ex.: "Procurando…").
    in property <bool> busy: false;
    in property <length> font-size: size == "sm" ? Theme.text-sm : size == "md" ? Theme.text-base : Theme.text-md;
    in property <bool> bold: false;
    in property <length> pad: size == "sm" ? 10px : size == "md" ? 12px : 16px;
    in property <length> icon-size: size == "sm" ? 13px : size == "md" ? 14px : 16px;
    callback clicked;

    property <bool> flat: kind == "ghost" || kind == "outline";
    property <color> base: kind == "primary" ? Theme.primary : kind == "strong" ? Theme.strong : kind == "danger" ? Theme.danger-bg : kind == "secondary" ? Theme.muted : transparent;
    property <color> ink: kind == "primary" ? Theme.primary-fg : kind == "strong" ? Theme.strong-fg : kind == "danger" ? Theme.danger-fg : kind == "ghost" ? Theme.muted-fg : Theme.fg;
    property <bool> lit: ta.has-hover && root.kind == "ghost";

    accessible-role: button;
    accessible-label: text;
    // Em linhas, o botão fica do tamanho do conteúdo (não divide o espaço livre).
    horizontal-stretch: 0;
    accessible-enabled: enabled;
    accessible-action-default => { root.clicked(); }
    height: size == "sm" ? 28px : size == "md" ? 32px : 40px;
    min-width: icon-only ? self.height : 0px;
    border-radius: size == "sm" ? Theme.radius-sm : Theme.radius-md;
    opacity: enabled ? 1 : 0.5;
    border-width: kind == "outline" ? 1px : 0px;
    border-color: Theme.field-border;
    background: !enabled ? base : ta.pressed ? (flat ? Theme.selected-bg : base.darker(0.12)) : ta.has-hover ? (flat ? Theme.muted : base.brighter(0.06)) : base;
    animate background { duration: 90ms; }

    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        padding-left: icon-only ? 0px : root.pad;
        padding-right: icon-only ? 0px : root.pad;
        spacing: 8px;
        alignment: center;
        if root.busy : VerticalLayout {
            alignment: center;
            Spinner { tint: root.ink; width: root.icon-size; height: root.icon-size; }
        }
        if root.has-icon && !root.busy : VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.lit ? Theme.fg : root.ink;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        if !root.icon-only : Text {
            text: root.text;
            color: root.lit ? Theme.fg : root.ink;
            font-size: root.font-size;
            font-weight: root.bold ? 700 : 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if fs.has-focus : FocusRing { radius: root.border-radius; }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    // Nome lido pelo leitor de tela (o texto ao lado).
    in property <string> label;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.interactive : Theme.field-border;
    animate background { duration: Theme.fast; }
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(!root.checked); }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }
    }
    Rectangle {
        width: 16px;
        height: 16px;
        y: 2px;
        x: root.checked ? 18px : 2px;
        border-radius: 8px;
        background: #ffffff;
        animate x { duration: Theme.fast; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
    if fs.has-focus : FocusRing { radius: 10px; }
}

// Etiqueta (qualidade, AO VIVO, AMIGO, contagens, "Experimental").
// kind: dark (sobre capa ou vídeo) | live | friend | neutral | warn | warn-soft | feature
export component Tag inherits Rectangle {
    in property <string> text;
    in property <string> kind: "dark";
    in property <bool> mono: true;
    property <color> ink: kind == "live" ? Theme.primary-fg : kind == "friend" ? Theme.friend-solid-fg : kind == "warn" ? #041010 : kind == "feature" ? Theme.feature-ink : kind == "dark" ? Theme.tag-fg : Theme.fg;
    background: kind == "live" ? Theme.live : kind == "friend" ? Theme.friend-solid : kind == "neutral" ? Theme.muted : kind == "warn" ? Theme.warn : kind == "warn-soft" ? Theme.warn.with-alpha(0.2) : kind == "feature" ? Theme.feature-bg : Theme.tag-bg;
    border-radius: Theme.radius-xs;
    height: 20px;
    width: t.preferred-width + 14px;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    t := Text {
        x: 7px;
        height: 100%;
        vertical-alignment: center;
        text: root.text;
        color: root.ink;
        font-size: Theme.text-xs;
        font-weight: 500;
        letter-spacing: root.mono ? 0.6px : 0px;
        font-family: root.mono ? Theme.mono : Theme.sans;
        accessible-role: none;
    }
}

// Bolinha de estado. kind: live | online | warn | err | muted
export component LiveDot inherits Rectangle {
    in property <string> kind: "live";
    in property <length> size: 8px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: kind == "online" ? Theme.online : kind == "warn" ? Theme.warn : kind == "err" ? Theme.destructive : kind == "muted" ? Theme.muted-fg : Theme.live;
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    in property <bool> secret: false;
    // Põe o cursor no campo (ex.: ao abrir uma janela).
    public function focus-input() { input.focus(); }
    in property <length> font-size: Theme.text-base;
    callback accepted(string);
    callback edited(string);
    height: 40px;
    background: Theme.card;
    border-radius: Theme.radius-md;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.focus : Theme.field-border;
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text <=> root.text;
        vertical-alignment: center;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        color: Theme.fg;
        selection-background-color: Theme.primary.with-alpha(0.35);
        font-size: root.font-size;
        font-family: root.mono ? Theme.mono : Theme.sans;
        accessible-label: root.placeholder;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
    Text {
        x: 12px;
        height: 100%;
        vertical-alignment: center;
        visible: root.text == "";
        text: root.placeholder;
        color: Theme.muted-fg;
        font-size: root.font-size;
        font-family: root.mono ? Theme.mono : Theme.sans;
        accessible-role: none;
    }
}

// Lista de opções (abre um menu abaixo). Enter, espaço ou seta para baixo abrem.
export component Select inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> value;
    in property <string> placeholder: "Escolha";
    // Nome lido pelo leitor de tela (o rótulo do campo).
    in property <string> label;
    callback selected(string);
    height: 40px;
    background: Theme.card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.fg.with-alpha(0.5) : Theme.field-border;
    accessible-role: combobox;
    accessible-label: label;
    accessible-action-default => { popup.show(); }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " " || e.text == Key.DownArrow) {
                popup.show();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            for opt in root.options : Text {
                width: 100%;
                height: 100%;
                visible: opt.value == root.value;
                text: opt.label;
                color: Theme.fg;
                font-size: Theme.text-base;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/chevron-down.svg");
                tint: Theme.muted-fg;
                width: 14px;
                height: 14px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    if fs.has-focus : FocusRing { radius: root.border-radius; }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius-md + 2px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: Theme.shadow-sm-blur;
            drop-shadow-offset-y: Theme.shadow-sm-y;
            drop-shadow-color: Theme.shadow-sm;
            VerticalLayout {
                padding: 4px;
                for opt in root.options : Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: item.has-hover ? Theme.muted : opt.value == root.value ? Theme.selected-bg : transparent;
                    accessible-role: list-item;
                    accessible-label: opt.label;
                    accessible-item-selected: opt.value == root.value;
                    accessible-action-default => { root.selected(opt.value); }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: opt.label;
                        color: Theme.fg;
                        font-size: Theme.text-base;
                        font-weight: opt.value == root.value ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected(opt.value); }
                    }
                }
            }
        }
    }
}

export component Slider inherits Rectangle {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <int> value;
    // Nome lido pelo leitor de tela.
    in property <string> label;
    // Cor do trilho vazio (sobre o vídeo, um branco translúcido).
    in property <color> track: Theme.muted;
    in property <color> fill: Theme.interactive;
    callback changed(int);
    height: 20px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value;
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-increment => { root.nudge(1); }
    accessible-action-decrement => { root.nudge(-1); }
    property <float> frac: (root.value - root.minimum) * 1.0 / (root.maximum - root.minimum);
    function set-from(x: length) {
        root.changed(Math.round(Math.max(0, Math.min(1, x / root.width)) * (root.maximum - root.minimum) / root.step) * root.step + root.minimum);
    }
    function nudge(dir: int) {
        root.changed(Math.max(root.minimum, Math.min(root.maximum, root.value + dir * root.step)));
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                root.nudge(1);
                return accept;
            }
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                root.nudge(-1);
                return accept;
            }
            reject
        }
    }
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: 100%;
        border-radius: 3px;
        background: root.track;
    }
    // Preenchido a partir da esquerda (sem x, o Slint centraliza e ele cresceria do meio).
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: parent.width * root.frac;
        border-radius: 3px;
        background: root.fill;
    }
    thumb := Rectangle {
        x: parent.width * root.frac - 8px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: root.fill;
        if fs.has-focus : FocusRing { radius: 8px; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// Abas em pílula (ex.: Telas | Janelas).
export component Segmented inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> value;
    callback selected(string);
    height: 32px;
    border-radius: Theme.radius-md;
    background: Theme.muted;
    accessible-role: tab-list;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt in root.options : Rectangle {
            border-radius: Theme.radius-sm;
            background: opt.value == root.value ? Theme.card : seg.has-hover ? Theme.selected-bg : transparent;
            animate background { duration: Theme.fast; }
            accessible-role: tab;
            accessible-label: opt.label;
            accessible-item-selected: opt.value == root.value;
            accessible-action-default => { root.selected(opt.value); }
            tab-fs := FocusScope {
                focus-on-click: false;
                key-pressed(e) => {
                    if (e.text == Key.Return || e.text == " ") {
                        root.selected(opt.value);
                        return accept;
                    }
                    reject
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: opt.label;
                    color: opt.value == root.value ? Theme.fg : Theme.muted-fg;
                    font-size: Theme.text-base;
                    font-weight: opt.value == root.value ? 600 : 500;
                    vertical-alignment: center;
                }
            }
            seg := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(opt.value); }
            }
            if tab-fs.has-focus : FocusRing { radius: Theme.radius-sm; }
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
}

// Título e subtítulo de um cartão.
export component CardTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    spacing: 4px;
    Text { text: root.title; font-size: Theme.text-lg; font-weight: 600; color: Theme.fg; }
    if root.body != "" : Text { text: root.body; font-size: Theme.text-base; color: Theme.muted-fg; wrap: word-wrap; }
}

// Capa de uma transmissão (iniciais sobre uma cor fixa por pessoa).
export component Cover inherits Rectangle {
    in property <string> initials;
    in property <int> idx: 1;
    in property <bool> big: false;
    // Capa de um amigo (roxo).
    in property <bool> friend: false;
    in property <length> text-size: 40px;
    clip: true;
    background: friend ? Theme.friend-bg : big ? Theme.feature-bg : Theme.cover-bg(idx);
    Text {
        width: 100%;
        height: 100%;
        text: root.initials;
        color: root.friend ? Theme.friend-ink : root.big ? Theme.feature-ink : Theme.cover-ink(root.idx);
        font-size: root.text-size;
        font-weight: 800;
        letter-spacing: -1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    @children
}

// Bloco de carregamento que pulsa (no lugar do conteúdo que ainda não chegou).
export component Skeleton inherits Rectangle {
    border-radius: Theme.radius-sm;
    background: Theme.skeleton.mix(Theme.skeleton-hi, (Math.sin(animation-tick() / 1.4s * 360deg) + 1) / 2);
}

export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <image> icon: @image-url("icons/radio.svg");
    min-height: 260px;
    border-radius: Theme.radius-lg;
    background: Theme.card.with-alpha(0.6);
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.muted;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    tint: Theme.muted-fg;
                    width: 20px;
                    height: 20px;
                }
            }
        }
        Text { text: root.title; font-size: Theme.text-lg; font-weight: 600; color: Theme.fg; horizontal-alignment: center; }
        Text { text: root.body; font-size: Theme.text-md; color: Theme.muted-fg; horizontal-alignment: center; wrap: word-wrap; }
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// Janela por cima do app: fundo escuro, cartão que entra subindo, clique fora fecha.
// O conteúdo (@children) fica num VerticalLayout dentro do cartão.
export component Dialog inherits Rectangle {
    in property <length> card-width: 420px;
    callback dismissed();
    property <bool> shown: false;
    init => { root.shown = true; }
    background: root.shown ? Theme.overlay : Theme.overlay.with-alpha(0);
    animate background { duration: Theme.normal; }
    TouchArea { clicked => { root.dismissed(); } }
    card := Rectangle {
        width: root.card-width;
        height: Math.min(content.preferred-height, root.height - 48px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (root.shown ? 0px : 12px);
        opacity: root.shown ? 1 : 0;
        animate y, opacity { duration: Theme.normal; easing: ease-out; }
        background: Theme.card;
        border-radius: Theme.radius-xl;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        drop-shadow-blur: Theme.shadow-lg-blur;
        drop-shadow-offset-y: Theme.shadow-lg-y;
        drop-shadow-color: Theme.shadow-lg;
        // Engole os cliques dentro do cartão (não fechar).
        TouchArea { }
        content := VerticalLayout {
            @children
        }
    }
}

// Impressão da chave de uma conta (docs/amizades.md): 4 figuras coloridas.
// As cores são fixas (fazem parte da impressão, iguais nos dois aparelhos).
export component KeyGlyphs inherits HorizontalLayout {
    in property <[Glyph]> glyphs;
    in property <length> size: 9px;
    spacing: root.size * 0.35;
    alignment: start;
    for g in root.glyphs : VerticalLayout {
        alignment: center;
        Rectangle {
            width: g.shape == 3 ? root.size * 0.6 : root.size;
            height: root.size;
            border-radius: g.shape == 1 ? root.size / 2 : g.shape == 2 ? root.size * 0.32 : 1.5px;
            background: g.color == 0 ? #31d5d8 : g.color == 1 ? #f2c14e : g.color == 2 ? #f0604f : g.color == 3 ? #3ddc97 : g.color == 4 ? #b38cff : #ff8fc7;
        }
    }
}
