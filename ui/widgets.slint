// Componentes reutilizáveis da interface.
import { Theme } from "theme.slint";
import { SelectOption } from "state.slint";

export component Eyebrow inherits Text {
    color: Theme.muted-fg;
    font-family: Theme.mono;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.1px;
}

export component Icon inherits Image {
    in property <color> tint: Theme.fg;
    colorize: tint;
    width: 16px;
    height: 16px;
    image-fit: contain;
}

// Botão. kind: primary | secondary | outline | ghost | strong | danger
export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> icon-only: false;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    in property <bool> bold: false;
    in property <length> pad: 14px;
    in property <length> icon-size: 16px;
    callback clicked;

    property <bool> flat: kind == "ghost" || kind == "outline";
    property <color> base: kind == "primary" ? Theme.primary : kind == "strong" ? Theme.strong : kind == "danger" ? Theme.destructive : kind == "secondary" ? Theme.muted : transparent;
    property <color> ink: kind == "primary" ? Theme.primary-fg : kind == "strong" ? Theme.strong-fg : kind == "danger" ? #ffffff : kind == "ghost" ? Theme.muted-fg : Theme.fg;

    accessible-role: button;
    accessible-label: text;
    // Em linhas, o botão fica do tamanho do conteúdo (não divide o espaço livre).
    horizontal-stretch: 0;
    accessible-enabled: enabled;
    accessible-action-default => { root.clicked(); }
    height: 40px;
    min-width: icon-only ? self.height : 0px;
    border-radius: 9px;
    opacity: enabled ? 1 : 0.5;
    border-width: kind == "outline" ? 1px : 0px;
    border-color: Theme.border;
    background: !enabled ? base : ta.pressed ? (flat ? Theme.accent : base.darker(0.12)) : ta.has-hover ? (flat ? Theme.muted : base.brighter(0.06)) : base;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: icon-only ? 0px : root.pad;
        padding-right: icon-only ? 0px : root.pad;
        spacing: 8px;
        alignment: center;
        if root.has-icon : VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: (ta.has-hover && root.kind == "ghost") ? Theme.fg : root.ink;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        if !root.icon-only : Text {
            text: root.text;
            color: (ta.has-hover && root.kind == "ghost") ? Theme.fg : root.ink;
            font-size: root.font-size;
            font-weight: root.bold ? 700 : 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.primary : Theme.input;
    animate background { duration: 120ms; }
    Rectangle {
        width: 16px;
        height: 16px;
        y: 2px;
        x: root.checked ? 18px : 2px;
        border-radius: 8px;
        background: #ffffff;
        animate x { duration: 120ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> bg: Theme.muted;
    in property <color> ink: Theme.fg;
    in property <bool> mono: true;
    height: 22px;
    width: t.preferred-width + 14px;
    border-radius: 6px;
    background: bg;
    t := Text {
        x: 7px;
        height: 100%;
        vertical-alignment: center;
        text: root.text;
        color: root.ink;
        font-size: 11px;
        font-weight: 500;
        font-family: root.mono ? Theme.mono : Theme.sans;
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    in property <bool> secret: false;
    // Põe o cursor no campo (ex.: ao abrir uma janela).
    public function focus-input() { input.focus(); }
    in property <length> font-size: 13px;
    callback accepted(string);
    callback edited(string);
    height: 40px;
    background: Theme.card;
    border-radius: 9px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.primary : Theme.border;
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text <=> root.text;
        vertical-alignment: center;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        color: Theme.fg;
        selection-background-color: Theme.primary.with-alpha(0.35);
        font-size: root.font-size;
        font-family: root.mono ? Theme.mono : Theme.sans;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
    Text {
        x: 12px;
        height: 100%;
        vertical-alignment: center;
        visible: root.text == "";
        text: root.placeholder;
        color: Theme.muted-fg;
        font-size: root.font-size;
        font-family: root.mono ? Theme.mono : Theme.sans;
    }
}

// Lista de opções (abre um menu abaixo).
export component Select inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> value;
    in property <string> placeholder: "Escolha";
    callback selected(string);
    height: 40px;
    background: Theme.card;
    border-radius: 9px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.input : Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            for opt in root.options : Text {
                width: 100%;
                height: 100%;
                visible: opt.value == root.value;
                text: opt.label;
                color: Theme.fg;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/chevron-down.svg");
                tint: Theme.muted-fg;
                width: 14px;
                height: 14px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.card;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 4px;
                for opt in root.options : Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: item.has-hover ? Theme.muted : opt.value == root.value ? Theme.accent : transparent;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: opt.label;
                        color: Theme.fg;
                        font-size: 13px;
                        font-weight: opt.value == root.value ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected(opt.value); }
                    }
                }
            }
        }
    }
}

export component Slider inherits Rectangle {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <int> value;
    callback changed(int);
    height: 20px;
    property <float> frac: (root.value - root.minimum) * 1.0 / (root.maximum - root.minimum);
    function set-from(x: length) {
        root.changed(Math.round(Math.max(0, Math.min(1, x / root.width)) * (root.maximum - root.minimum) / root.step) * root.step + root.minimum);
    }
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: 100%;
        border-radius: 3px;
        background: Theme.muted;
    }
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: parent.width * root.frac;
        border-radius: 3px;
        background: Theme.primary;
    }
    Rectangle {
        x: parent.width * root.frac - 8px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: Theme.primary;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// Abas em pílula (ex.: Telas | Janelas).
export component Segmented inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> value;
    callback selected(string);
    height: 34px;
    border-radius: 9px;
    background: Theme.muted;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt in root.options : Rectangle {
            border-radius: 7px;
            background: opt.value == root.value ? Theme.card : seg.has-hover ? Theme.accent : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: opt.label;
                    color: opt.value == root.value ? Theme.fg : Theme.muted-fg;
                    font-size: 13px;
                    font-weight: opt.value == root.value ? 600 : 500;
                    vertical-alignment: center;
                }
            }
            seg := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(opt.value); }
            }
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border;
}

// Capa de uma transmissão (iniciais sobre uma cor fixa por pessoa).
export component Cover inherits Rectangle {
    in property <string> initials;
    in property <int> idx: 1;
    in property <bool> big: false;
    in property <length> text-size: 40px;
    clip: true;
    background: big ? Theme.feature-bg : Theme.cover-bg(idx);
    Text {
        width: 100%;
        height: 100%;
        text: root.initials;
        color: root.big ? Theme.feature-ink : Theme.cover-ink(root.idx);
        font-size: root.text-size;
        font-weight: 800;
        letter-spacing: -1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    @children
}

// Etiqueta escura sobre capas e vídeo (qualidade, contagem).
export component Tag inherits Rectangle {
    in property <string> text;
    background: Theme.tag-bg;
    border-radius: 4px;
    width: t.preferred-width + 12px;
    height: t.preferred-height + 6px;
    t := Text {
        x: 6px;
        y: 3px;
        text: root.text;
        color: Theme.tag-fg;
        font-size: 11px;
        font-family: Theme.mono;
    }
}

export component Spinner inherits Rectangle {
    in property <color> tint: Theme.primary;
    width: 16px;
    height: 16px;
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("icons/loader.svg");
        colorize: root.tint;
        transform-rotation: animation-tick() * 360deg / 0.9s;
    }
}

export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <image> icon: @image-url("icons/radio.svg");
    min-height: 260px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card.with-alpha(0.6);
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.muted;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    tint: Theme.muted-fg;
                    width: 20px;
                    height: 20px;
                }
            }
        }
        Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.fg; horizontal-alignment: center; }
        Text { text: root.body; font-size: 14px; color: Theme.muted-fg; horizontal-alignment: center; wrap: word-wrap; }
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}
