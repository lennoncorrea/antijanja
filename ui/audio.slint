// Escolha da fonte de áudio que vai junto com a transmissão.
import { Theme } from "theme.slint";
import { App } from "state.slint";
import { Btn, FocusRing, Icon, Select } from "widgets.slint";

component ModeTile inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <image> icon;
    property <bool> on: App.s-audio-mode == value;
    height: 40px;
    border-radius: Theme.radius-md;
    border-width: on ? 2px : 1px;
    border-color: on ? Theme.interactive : ta.has-hover ? Theme.field-border : Theme.border;
    background: on ? Theme.selected-bg : ta.has-hover ? Theme.muted : transparent;
    animate background, border-color { duration: Theme.fast; }
    accessible-role: radio-button;
    accessible-label: label;
    accessible-checked: on;
    accessible-action-default => { App.set-setting("audio-mode", root.value); }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                App.set-setting("audio-mode", root.value);
                return accept;
            }
            reject
        }
    }
    if fs.has-focus : FocusRing { radius: root.border-radius; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.on ? Theme.fg : Theme.muted-fg;
            }
        }
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: Theme.text-base;
            font-weight: root.on ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.set-setting("audio-mode", root.value); }
    }
}

export component AudioSource inherits VerticalLayout {
    // 4 = uma linha só; 2 = grade 2×2.
    in property <int> columns: 2;
    vertical-stretch: 0;
    spacing: 10px;
    if root.columns == 4 : HorizontalLayout {
        spacing: 8px;
        ModeTile { value: "none"; label: "Sem áudio"; icon: @image-url("icons/volume-x.svg"); }
        ModeTile { value: "system"; label: "Todo o PC"; icon: @image-url("icons/volume.svg"); }
        ModeTile { value: "exclude"; label: "Tudo, menos um app"; icon: @image-url("icons/volume-minus.svg"); }
        ModeTile { value: "include"; label: "Só um app"; icon: @image-url("icons/app-window.svg"); }
    }
    if root.columns != 4 : VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            ModeTile { value: "none"; label: "Sem áudio"; icon: @image-url("icons/volume-x.svg"); }
            ModeTile { value: "system"; label: "Todo o PC"; icon: @image-url("icons/volume.svg"); }
        }
        HorizontalLayout {
            spacing: 8px;
            ModeTile { value: "exclude"; label: "Tudo, menos um app"; icon: @image-url("icons/volume-minus.svg"); }
            ModeTile { value: "include"; label: "Só um app"; icon: @image-url("icons/app-window.svg"); }
        }
    }
    if App.s-audio-mode == "exclude" || App.s-audio-mode == "include" : HorizontalLayout {
        spacing: 8px;
        Select {
            label: "App do áudio";
            horizontal-stretch: 1;
            options: App.app-options;
            value: App.s-audio-app;
            selected(v) => { App.set-setting("audio-app", v); }
        }
        Btn {
            width: 40px;
            kind: "outline";
            icon-only: true;
            icon: @image-url("icons/refresh.svg");
            has-icon: true;
            accessible-label: "Atualizar lista de apps";
            clicked => { App.refresh-apps(); }
        }
    }
}
