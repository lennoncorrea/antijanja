// "O que você quer transmitir?": telas e janelas com miniatura.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { App, Source } from "state.slint";
import { AudioSource } from "audio.slint";
import { Btn, Divider, FocusRing, Icon, Segmented, Spinner, Tag, TextField, Toggle } from "widgets.slint";

component SourceCard inherits Rectangle {
    in property <Source> s;
    property <bool> selected: App.picker-selected == s.id;
    opacity: s.blank ? 0 : 1;
    border-radius: Theme.radius-lg;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.interactive : ta.has-hover ? Theme.field-border : Theme.border;
    animate border-color { duration: Theme.fast; }
    accessible-role: radio-button;
    accessible-label: root.s.name;
    accessible-checked: root.selected;
    accessible-action-default => { App.picker-select(root.s.id); }
    background: Theme.card;
    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;
        Rectangle {
            height: self.width * 9 / 16;
            border-radius: Theme.radius-md;
            background: Theme.muted;
            clip: true;
            if root.s.has-thumb : Image {
                width: 100%;
                height: 100%;
                source: root.s.thumb;
                image-fit: contain;
            }
            if !root.s.has-thumb : Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 28px;
                source: root.s.is-window ? @image-url("icons/app-window.svg") : @image-url("icons/monitor.svg");
                tint: Theme.muted-fg;
            }
            HorizontalLayout {
                x: 8px;
                y: 8px;
                height: 20px;
                spacing: 4px;
                if root.s.primary : Tag { text: "PRINCIPAL"; }
                if root.s.current : Tag { kind: "live"; text: "NO AR"; }
            }
        }
        VerticalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 1px;
            Text { text: root.s.name; font-size: Theme.text-base; font-weight: 600; color: Theme.fg; overflow: elide; }
            Text { text: root.s.detail; font-size: Theme.text-sm; color: Theme.muted-fg; overflow: elide; }
        }
    }
    fs := FocusScope {
        enabled: !root.s.blank;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " ") {
                App.picker-select(root.s.id);
                return accept;
            }
            if (e.text == Key.Return) {
                App.picker-confirm(root.s.id);
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: !root.s.blank;
        mouse-cursor: pointer;
        clicked => { App.picker-select(root.s.id); }
        double-clicked => { App.picker-confirm(root.s.id); }
    }
    if fs.has-focus : FocusRing { radius: root.border-radius; }
}

// Uma das duas opções de "Quem pode entrar" (pública ou só com código).
component VisibilityOption inherits Rectangle {
    in property <bool> on;
    in property <image> icon;
    in property <string> title;
    in property <string> detail;
    callback picked();
    height: 60px;
    border-radius: Theme.radius-md;
    border-width: root.on ? 2px : 1px;
    border-color: root.on ? Theme.interactive : ta.has-hover ? Theme.field-border : Theme.border;
    background: root.on ? Theme.feature-bg : Theme.raised;
    animate background, border-color { duration: Theme.fast; }
    accessible-role: radio-button;
    accessible-checked: root.on;
    accessible-label: root.title;
    accessible-action-default => { root.picked(); }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.picked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    if fs.has-focus : FocusRing { radius: root.border-radius; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; tint: root.on ? Theme.live-text : Theme.muted-fg; width: 18px; height: 18px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; font-size: Theme.text-md; font-weight: 700; color: Theme.fg; }
            Text { text: root.detail; font-size: Theme.text-sm; color: root.on ? Theme.soft-fg : Theme.muted-fg; overflow: elide; }
        }
    }
}

export component SourcePicker inherits Rectangle {
    background: Theme.overlay;
    // Clique fora fecha.
    TouchArea {
        clicked => { App.close-picker(); }
    }
    property <bool> shown: false;
    init => { root.shown = true; }
    dialog := Rectangle {
        width: Math.min(parent.width - 48px, 900px);
        height: Math.min(parent.height - 48px, App.picker == "start" ? (App.picker-pw-on ? 960px : 910px) : 620px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.shown ? 0px : 12px);
        opacity: root.shown ? 1 : 0;
        animate y, opacity { duration: Theme.normal; easing: ease-out; }
        border-radius: Theme.radius-xl;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.card;
        drop-shadow-blur: Theme.shadow-lg-blur;
        drop-shadow-offset-y: Theme.shadow-lg-y;
        drop-shadow-color: Theme.shadow-lg;
        clip: true;
        // Engole os cliques dentro do diálogo (não fechar).
        TouchArea { }
        VerticalLayout {
          VerticalLayout {
            vertical-stretch: 1;
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: App.picker == "switch" ? "Trocar o que está sendo transmitido" : "O que você quer transmitir?";
                        font-size: Theme.text-xl;
                        font-weight: 600;
                        color: Theme.fg;
                    }
                    Text {
                        text: App.picker == "switch" ? "Quem está assistindo continua conectado, com o mesmo código." : "Escolha uma tela inteira ou só uma janela.";
                        font-size: Theme.text-base;
                        color: Theme.muted-fg;
                    }
                }
                Rectangle { }
                VerticalLayout {
                    alignment: start;
                    Btn {
                        size: "md";
                        kind: "ghost";
                        icon-only: true;
                        icon: @image-url("icons/x.svg");
                        has-icon: true;
                        accessible-label: "Fechar";
                        clicked => { App.close-picker(); }
                    }
                }
            }
            HorizontalLayout {
                Segmented {
                    options: [
                        { value: "monitor", label: App.sources-loading ? "Telas" : "Telas  " + App.count-monitors },
                        { value: "window", label: App.sources-loading ? "Janelas" : "Janelas  " + App.count-windows }
                    ];
                    value: App.picker-tab;
                    selected(v) => { App.picker-tab-changed(v); }
                }
                Rectangle { }
                Btn {
                    size: "md";
                    kind: "ghost";
                    text: "Atualizar";
                    icon: @image-url("icons/refresh.svg");
                    has-icon: true;
                    busy: App.sources-loading;
                    enabled: !App.sources-loading;
                    clicked => { App.picker-refresh(); }
                }
            }

            // Miniaturas e opções rolam juntas, cada uma no tamanho natural: numa janela
            // baixa nada fica espremido ou cortado (antes as miniaturas ficavam com o que
            // sobrava depois das opções).
            ScrollView {
                vertical-stretch: 1;
                min-height: 160px;
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: 14px;
                    padding-bottom: 4px;
                    // Espaço da barra de rolagem: ela não fica por cima dos cartões.
                    padding-right: 14px;
                    if App.sources-loading : HorizontalLayout {
                        height: 160px;
                        alignment: center;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Spinner { }
                        }
                        Text { text: "Procurando telas e janelas…"; font-size: Theme.text-base; color: Theme.muted-fg; vertical-alignment: center; }
                    }
                    if !App.sources-loading && App.source-rows.length == 0 : Text {
                        height: 120px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        text: App.picker-tab == "window" ? "Nenhuma janela aberta para transmitir. Janelas minimizadas não aparecem." : "Nenhuma tela encontrada.";
                        font-size: Theme.text-base;
                        color: Theme.muted-fg;
                    }
                    if !App.sources-loading : VerticalLayout {
                        spacing: 12px;
                        for row in App.source-rows : HorizontalLayout {
                            spacing: 12px;
                            for s in row.items : SourceCard {
                                horizontal-stretch: 1;
                                s: s;
                            }
                        }
                    }
                    if App.picker == "start" : VerticalLayout {
                        spacing: 12px;
                        Divider { }
                        Text { text: "Áudio que vai junto"; font-size: Theme.text-base; font-weight: 500; color: Theme.fg; }
                        AudioSource {
                            columns: 4;
                        }
                        Text { text: "Quem pode entrar"; font-size: Theme.text-base; font-weight: 500; color: Theme.fg; }
                        HorizontalLayout {
                            spacing: 10px;
                            VisibilityOption {
                                horizontal-stretch: 1;
                                on: App.s-public;
                                icon: @image-url("icons/globe.svg");
                                title: "Pública";
                                detail: "Aparece em “Ao vivo agora”";
                                picked => { App.set-setting("public", "1"); }
                            }
                            VisibilityOption {
                                horizontal-stretch: 1;
                                on: !App.s-public;
                                icon: @image-url("icons/link.svg");
                                title: "Só com código";
                                detail: "Amigos e quem receber o código";
                                picked => { App.set-setting("public", "0"); }
                            }
                        }
                        // Senha: quem assiste precisa do código e dela (na lista aparece um cadeado).
                        Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.raised;
                            VerticalLayout {
                                padding: 12px;
                                padding-left: 16px;
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 16px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            VerticalLayout {
                                                alignment: center;
                                                Icon { source: @image-url("icons/lock.svg"); tint: App.picker-pw-on ? Theme.live-text : Theme.muted-fg; width: 13px; height: 13px; }
                                            }
                                            Text { text: "Pedir senha"; font-size: Theme.text-base; font-weight: 500; color: Theme.fg; }
                                        }
                                        Text {
                                            text: "Só entra quem tiver o código e a senha.";
                                            font-size: Theme.text-sm;
                                            color: Theme.muted-fg;
                                            wrap: word-wrap;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Toggle {
                                            label: "Pedir senha";
                                            checked: App.picker-pw-on;
                                            toggled(v) => { App.picker-pw-toggled(v); }
                                        }
                                    }
                                }
                                if App.picker-pw-on : TextField {
                                    secret: true;
                                    placeholder: "Senha da transmissão";
                                    text: App.picker-pw;
                                    edited(t) => { App.picker-pw-edited(t); }
                                    init => { self.focus-input(); }
                                }
                            }
                        }
                        // Malha P2P: a mesma opção das configurações da transmissão, aqui para
                        // escolher antes de começar (ligada durante a transmissão, só vale na próxima).
                        Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.raised;
                            HorizontalLayout {
                                padding: 12px;
                                padding-left: 16px;
                                spacing: 16px;
                                VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "Malha P2P"; font-size: Theme.text-base; font-weight: 500; color: Theme.fg; vertical-alignment: center; }
                                        Tag { kind: "warn-soft"; mono: false; text: "Experimental"; }
                                    }
                                    Text {
                                        text: "Quem assiste repassa o vídeo para os outros: sua internet manda menos.";
                                        font-size: Theme.text-sm;
                                        color: Theme.muted-fg;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: "Malha P2P";
                                        checked: App.s-mesh;
                                        toggled(v) => { App.set-setting("mesh", v ? "1" : "0"); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

          }
            Rectangle {
                height: 64px;
                background: Theme.muted.with-alpha(0.5);
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 8px;
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            kind: "ghost";
                            text: "Cancelar";
                            clicked => { App.close-picker(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            kind: "primary";
                            text: App.picker == "switch" ? "Trocar para esta fonte" : App.s-public ? "Começar transmissão pública" : "Começar só com código";
                            enabled: App.picker-selected != "";
                            clicked => { App.picker-confirm(App.picker-selected); }
                        }
                    }
                }
            }
        }
    }
}
