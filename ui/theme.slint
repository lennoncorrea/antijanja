// Identidade do AntiJanja. Paleta base (Realtime Colors), escura · clara:
// texto #e6f9f9 · #061919, fundo #041010 · #effbfb, primária #31d5d8 · #27cbce,
// secundária #2e1a6b · #a894e5, destaque #6b269c · #a863d9.
// O app abre no tema do Windows.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/Inter-ExtraBold.ttf";
import "../assets/fonts/JetBrainsMono-Medium.ttf";

export global Theme {
    in-out property <bool> dark: true;

    out property <string> sans: "Inter";
    out property <string> mono: "JetBrains Mono";

    out property <color> bg: dark ? #041010 : #effbfb;
    out property <color> fg: dark ? #e6f9f9 : #061919;
    out property <color> card: dark ? #0a1b1b : #ffffff;
    out property <color> muted: dark ? #112727 : #dcefef;
    out property <color> muted-fg: dark ? #8db1b1 : #466565;
    out property <color> soft-fg: dark ? #c0dddd : #1f3d3d;
    out property <color> accent: dark ? #163232 : #d2e9e9;
    out property <color> border: dark ? #183232 : #cde5e5;
    out property <color> input: dark ? #234242 : #b6d6d6;
    out property <color> rail: dark ? #061414 : #e5f5f5;
    out property <color> primary: dark ? #31d5d8 : #27cbce;
    out property <color> primary-fg: dark ? #041010 : #061919;
    out property <color> live: dark ? #31d5d8 : #27cbce;
    // Ciano para texto: no tema claro o ciano da marca não tem contraste para texto.
    out property <color> live-text: dark ? #31d5d8 : #00787a;
    out property <color> strong: dark ? #e6f9f9 : #061919;
    out property <color> strong-fg: dark ? #041010 : #effbfb;
    out property <color> destructive: dark ? #f0604f : #d93a2b;
    out property <color> warn: dark ? #f2c14e : #b7791f;
    out property <color> overlay: dark ? #000000b3 : #06191966;
    // Capa grande (transmissão em destaque) e etiquetas escuras sobre imagem.
    out property <color> feature-bg: dark ? #0a2a2b : #d3f3f3;
    out property <color> feature-ink: dark ? #31d5d8 : #00787a;
    out property <color> tag-bg: #041010d9;
    out property <color> tag-fg: #e6f9f9;
    // Amigos em roxo (ciano = ao vivo e ações): fundo e texto da capa de um amigo,
    // a etiqueta "AMIGO" (cheia) e o roxo para texto.
    out property <color> friend-bg: dark ? #2e1a6b : #a894e5;
    out property <color> friend-ink: dark ? #d8cdfa : #140a33;
    out property <color> friend-solid: dark ? #6b269c : #a863d9;
    out property <color> friend-solid-fg: dark ? #ffffff : #140a33;
    out property <color> friend-text: dark ? #c99cf0 : #7a2fb0;

    // Capas das transmissões (sem miniatura): fundo e iniciais, 3 variações.
    pure public function cover-bg(i: int) -> color {
        if (dark) {
            return i == 1 ? #083233 : i == 2 ? #0f2b2b : #1d1840;
        }
        return i == 1 ? #d3f3f3 : i == 2 ? #dcefef : #e6defa;
    }
    pure public function cover-ink(i: int) -> color {
        if (dark) {
            return i == 1 ? #31d5d8 : i == 2 ? #5cc8c9 : #b9a6f0;
        }
        return i == 1 ? #00787a : i == 2 ? #1f6b6c : #5a3a9e;
    }
}
