// Identidade do AntiJanja. Paleta base (Realtime Colors), escura · clara:
// texto #e6f9f9 · #061919, fundo #041010 · #effbfb, primária #31d5d8 · #27cbce,
// secundária #2e1a6b · #a894e5, destaque #6b269c · #a863d9.
// O app abre no tema do Windows.
//
// Contraste (WCAG 2.2 AA): texto 4.5:1; bordas de controles, foco e partes que
// mostram estado 3:1. As razões ao lado de cada cor foram calculadas contra o fundo
// em que ela é usada.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/Inter-ExtraBold.ttf";
import "../assets/fonts/JetBrainsMono-Medium.ttf";

export global Theme {
    in-out property <bool> dark: true;

    out property <string> sans: "Inter";
    out property <string> mono: "JetBrains Mono";

    // Escala de fonte (use estas, não px soltos).
    out property <length> text-xs: 11px;   // etiquetas, metadados
    out property <length> text-sm: 12px;   // textos de apoio
    out property <length> text-base: 13px; // corpo, listas, campos
    out property <length> text-md: 14px;   // botões, nomes
    out property <length> text-lg: 16px;   // título de cartão
    out property <length> text-xl: 18px;   // título de tela
    out property <length> text-2xl: 26px;  // destaque
    out property <length> text-3xl: 34px;  // título da Início

    // Raios.
    out property <length> radius-xs: 4px;  // etiquetas
    out property <length> radius-sm: 6px;  // controles pequenos (≤ 28px)
    out property <length> radius-md: 8px;  // botões, campos, linhas
    out property <length> radius-lg: 12px; // cartões
    out property <length> radius-xl: 16px; // diálogos

    // Sombras: pequena (menus, avisos) e grande (diálogos).
    out property <color> shadow-sm: dark ? #00000059 : #06191926;
    out property <length> shadow-sm-blur: 16px;
    out property <length> shadow-sm-y: 4px;
    out property <color> shadow-lg: dark ? #00000073 : #06191938;
    out property <length> shadow-lg-blur: 28px;
    out property <length> shadow-lg-y: 8px;

    // Duração das animações.
    out property <duration> fast: 120ms;
    out property <duration> normal: 180ms;

    out property <color> bg: dark ? #041010 : #effbfb;
    out property <color> fg: dark ? #e6f9f9 : #061919;
    out property <color> card: dark ? #0a1b1b : #ffffff;
    // Camada acima do cartão (blocos dentro de cartões, no lugar de uma borda).
    out property <color> raised: dark ? #0f2323 : #f3fafa;
    out property <color> muted: dark ? #112727 : #dcefef;
    out property <color> muted-fg: dark ? #8db1b1 : #466565;
    out property <color> soft-fg: dark ? #c0dddd : #1f3d3d;
    // Fundo de item escolhido ou apertado (não é o "destaque" roxo da paleta).
    out property <color> selected-bg: dark ? #163232 : #d2e9e9;
    // Divisórias e contorno de cartões (decorativos).
    out property <color> border: dark ? #183232 : #cde5e5;
    // Contorno de controles: campos, listas, toggle desligado (3.5:1 nos dois temas).
    out property <color> field-border: dark ? #4f7676 : #6b8f8f;
    out property <color> input: dark ? #234242 : #b6d6d6;
    out property <color> rail: dark ? #061414 : #e5f5f5;
    out property <color> primary: dark ? #31d5d8 : #27cbce;
    out property <color> primary-fg: dark ? #041010 : #061919;
    // Ciano de controles (toggle ligado, slider, seleção). No claro o ciano da marca
    // tem só 2:1 sobre branco; este tem 4.35:1.
    out property <color> interactive: dark ? #31d5d8 : #00878a;
    // Anel do foco do teclado.
    out property <color> focus: dark ? #31d5d8 : #00878a;
    out property <color> live: dark ? #31d5d8 : #27cbce;
    // Ciano para texto: no tema claro o ciano da marca não tem contraste para texto.
    out property <color> live-text: dark ? #31d5d8 : #00787a;
    out property <color> online: dark ? #3ddc97 : #16915c;
    out property <color> strong: dark ? #e6f9f9 : #061919;
    out property <color> strong-fg: dark ? #041010 : #effbfb;
    // Vermelho para texto e ícones.
    out property <color> destructive: dark ? #f0604f : #d93a2b;
    // Botão de perigo: fundo e texto (5.97:1 e 5.48:1).
    out property <color> danger-bg: dark ? #f0604f : #c62f22;
    out property <color> danger-fg: dark ? #041010 : #ffffff;
    // Amarelo de aviso para fundos e ícones; para texto use warn-text.
    out property <color> warn: dark ? #f2c14e : #b7791f;
    out property <color> warn-text: dark ? #f2c14e : #8a5a0f;
    out property <color> overlay: dark ? #000000b3 : #06191966;
    // Capa grande (transmissão em destaque) e etiquetas escuras sobre imagem.
    out property <color> feature-bg: dark ? #0a2a2b : #d3f3f3;
    out property <color> feature-ink: dark ? #31d5d8 : #00787a;
    out property <color> tag-bg: #041010d9;
    out property <color> tag-fg: #e6f9f9;
    // Amigos em roxo (ciano = ao vivo e ações): fundo e texto da capa de um amigo,
    // a etiqueta "AMIGO" (cheia) e o roxo para texto.
    out property <color> friend-bg: dark ? #2e1a6b : #a894e5;
    out property <color> friend-ink: dark ? #d8cdfa : #140a33;
    out property <color> friend-solid: dark ? #6b269c : #a863d9;
    out property <color> friend-solid-fg: dark ? #ffffff : #140a33;
    out property <color> friend-text: dark ? #c99cf0 : #7a2fb0;
    // Esqueleto (carregando): base e brilho.
    out property <color> skeleton: dark ? #112727 : #dcefef;
    out property <color> skeleton-hi: dark ? #183535 : #e9f6f6;

    // Capas das transmissões (sem miniatura): fundo e iniciais, 3 variações.
    pure public function cover-bg(i: int) -> color {
        if (dark) {
            return i == 1 ? #083233 : i == 2 ? #0f2b2b : #1d1840;
        }
        return i == 1 ? #d3f3f3 : i == 2 ? #dcefef : #e6defa;
    }
    pure public function cover-ink(i: int) -> color {
        if (dark) {
            return i == 1 ? #31d5d8 : i == 2 ? #5cc8c9 : #b9a6f0;
        }
        return i == 1 ? #00787a : i == 2 ? #1f6b6c : #5a3a9e;
    }
}

// Cores fixas dos controles por cima do vídeo (iguais em qualquer tema).
export global Ink {
    out property <color> fg: #e6f9f9;
    out property <color> soft: #c0dddd;
    out property <color> hover: #ffffff24;
    out property <color> cyan: #31d5d8;
    out property <color> track: #ffffff40;
    out property <color> avatar-bg: #083233;
}
