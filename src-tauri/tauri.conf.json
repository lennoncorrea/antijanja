{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AntiJanja",
  "version": "2.5.0",
  "identifier": "app.antijanja.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AntiJanja",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "backgroundColor": "#06100a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMkFDNDY3MTI1MkI5OEUKUldTT3VWSVNaOFFxcWoxd01MNC9nSWJDdVFpUmZ2VWpTM0lMOGJ0TnVwc1hUUlNZcjg0SHNDcVgK",
      "endpoints": [
        "https://github.com/lennoncorrea/antijanja/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
